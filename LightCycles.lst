000946r 2  02 01 51 09          .byte $02, $01, $51, $09, $06
00094Ar 2  06           
00094Br 2                       ; $40 '@' (blank - not used by this game)
00094Br 2  00 00 00 00          .byte $00, $00, $00, $00, $00
00094Fr 2  00           
000950r 2                       ; $41 'A'
000950r 2  7E 09 09 09          .byte $7E, $09, $09, $09, $7E
000954r 2  7E           
000955r 2                       ; $42 'B'
000955r 2  7F 49 49 49          .byte $7F, $49, $49, $49, $36
000959r 2  36           
