000227r 2               @bottom:
000227r 2  A9 B7          lda #ARENA_MAX_Y
000229r 2  20 rr rr       jsr PixelSetBorder
00022Cr 2  E8             inx
00022Dr 2  E0 F7          cpx #ARENA_MAX_X
00022Fr 2  D0 F6          bne @bottom
000231r 2  A9 B7          lda #ARENA_MAX_Y
000233r 2  20 rr rr       jsr PixelSetBorder
000236r 2               
