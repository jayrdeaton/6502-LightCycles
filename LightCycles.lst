0008ABr 1               .include "src/font.asm"
0008ABr 2               ; ============================================================
0008ABr 2               ; font.asm - 5x7 pixel bitmap font for LightCycles (TMS9918 Graphics II)
0008ABr 2               ; ============================================================
0008ABr 2               ; FontData is a dense table covering ASCII $20 (space) through $5A ('Z')
0008ABr 2               ; inclusive, 5 bytes per glyph, in ascending ASCII order with no gaps.
0008ABr 2               ;
0008ABr 2               ; To look up a glyph for character C (where C is in $20..$5A):
0008ABr 2               ;     offset = (C - $20) * 5
0008ABr 2               ;   FontData+offset .. FontData+offset+4 are the glyph's 5 column bytes.
0008ABr 2               ;
0008ABr 2               ; Each glyph is 5 pixels wide x 7 pixels tall, stored as 5 consecutive
0008ABr 2               ; bytes - one byte per COLUMN, left column first (col0, col1, col2,
0008ABr 2               ; col3, col4).
0008ABr 2               ;
0008ABr 2               ; Within each column byte, bits correspond to rows top-to-bottom:
0008ABr 2               ;   bit0 (value $01) = row 0 (TOP row of the glyph)
0008ABr 2               ;   bit1 (value $02) = row 1
0008ABr 2               ;   bit2 (value $04) = row 2
0008ABr 2               ;   bit3 (value $08) = row 3
0008ABr 2               ;   bit4 (value $10) = row 4
0008ABr 2               ;   bit5 (value $20) = row 5
0008ABr 2               ;   bit6 (value $40) = row 6 (BOTTOM row of the glyph)
0008ABr 2               ;   bit7             = unused, always 0
0008ABr 2               ;
0008ABr 2               ; So every byte in this table is in the range $00-$7F.
0008ABr 2               ;
0008ABr 2               ; Example - capital 'A':
0008ABr 2               ;   .XXX.
0008ABr 2               ;   X...X
0008ABr 2               ;   X...X
0008ABr 2               ;   XXXXX
0008ABr 2               ;   X...X
0008ABr 2               ;   X...X
0008ABr 2               ;   X...X
0008ABr 2               ; encodes as: .byte $7E, $09, $09, $09, $7E
0008ABr 2               ;
0008ABr 2               ; Characters that have no clear standard 5x7 glyph, or that this game
0008ABr 2               ; will never plausibly display (# $ % & * @), are left blank (all
0008ABr 2               ; zero bytes) rather than inventing an arbitrary shape for them.
0008ABr 2               ; ============================================================
0008ABr 2               
0008ABr 2               FontData:
0008ABr 2                       ; $20 ' ' (space)
0008ABr 2  00 00 00 00          .byte $00, $00, $00, $00, $00
0008AFr 2  00           
0008B0r 2                       ; $21 '!'
0008B0r 2  00 00 5F 00          .byte $00, $00, $5F, $00, $00
0008B4r 2  00           
0008B5r 2                       ; $22 '"'
0008B5r 2  00 03 00 03          .byte $00, $03, $00, $03, $00
0008B9r 2  00           
0008BAr 2                       ; $23 '#' (blank - not used by this game)
0008BAr 2  00 00 00 00          .byte $00, $00, $00, $00, $00
0008BEr 2  00           
0008BFr 2                       ; $24 '$' (blank - not used by this game)
0008BFr 2  00 00 00 00          .byte $00, $00, $00, $00, $00
0008C3r 2  00           
0008C4r 2                       ; $25 '%' (blank - not used by this game)
0008C4r 2  00 00 00 00          .byte $00, $00, $00, $00, $00
0008C8r 2  00           
0008C9r 2                       ; $26 '&' (blank - not used by this game)
0008C9r 2  00 00 00 00          .byte $00, $00, $00, $00, $00
0008CDr 2  00           
0008CEr 2                       ; $27 '''
0008CEr 2  00 00 03 00          .byte $00, $00, $03, $00, $00
0008D2r 2  00           
0008D3r 2                       ; $28 '('
0008D3r 2  00 1C 22 41          .byte $00, $1C, $22, $41, $00
0008D7r 2  00           
0008D8r 2                       ; $29 ')'
0008D8r 2  00 41 22 1C          .byte $00, $41, $22, $1C, $00
0008DCr 2  00           
0008DDr 2                       ; $2A '*' (blank - not used by this game)
0008DDr 2  00 00 00 00          .byte $00, $00, $00, $00, $00
0008E1r 2  00           
0008E2r 2                       ; $2B '+'
0008E2r 2  08 08 3E 08          .byte $08, $08, $3E, $08, $08
0008E6r 2  08           
0008E7r 2                       ; $2C ','
0008E7r 2  00 40 20 00          .byte $00, $40, $20, $00, $00
0008EBr 2  00           
0008ECr 2                       ; $2D '-'
0008ECr 2  08 08 08 08          .byte $08, $08, $08, $08, $08
0008F0r 2  08           
0008F1r 2                       ; $2E '.'
0008F1r 2  00 00 40 00          .byte $00, $00, $40, $00, $00
0008F5r 2  00           
0008F6r 2                       ; $2F '/'
0008F6r 2  60 10 08 04          .byte $60, $10, $08, $04, $03
0008FAr 2  03           
