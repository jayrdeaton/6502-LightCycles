000923r 2  36 49 49 49          .byte $36, $49, $49, $49, $36
000927r 2  36           
000928r 2                       ; $39 '9'
000928r 2  06 49 49 29          .byte $06, $49, $49, $29, $1E
00092Cr 2  1E           
00092Dr 2                       ; $3A ':' -- 2x2 dots (not 1x1) so it survives display scaling;
00092Dr 2                       ; a single isolated pixel was getting lost entirely on screen
00092Dr 2  00 36 36 00          .byte $00, $36, $36, $00, $00
000931r 2  00           
000932r 2                       ; $3B ';'
000932r 2  00 40 34 00          .byte $00, $40, $34, $00, $00
000936r 2  00           
000937r 2                       ; $3C '<'
000937r 2  00 08 14 22          .byte $00, $08, $14, $22, $41
00093Br 2  41           
00093Cr 2                       ; $3D '='
00093Cr 2  14 14 14 14          .byte $14, $14, $14, $14, $14
000940r 2  14           
000941r 2                       ; $3E '>'
000941r 2  41 22 14 08          .byte $41, $22, $14, $08, $00
000945r 2  00           
