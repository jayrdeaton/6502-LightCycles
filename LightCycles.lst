00096Dr 2  01           
00096Er 2                       ; $47 'G'
00096Er 2  3E 41 49 49          .byte $3E, $41, $49, $49, $3A
000972r 2  3A           
000973r 2                       ; $48 'H'
000973r 2  7F 08 08 08          .byte $7F, $08, $08, $08, $7F
000977r 2  7F           
000978r 2                       ; $49 'I'
000978r 2  41 41 7F 41          .byte $41, $41, $7F, $41, $41
00097Cr 2  41           
00097Dr 2                       ; $4A 'J'
00097Dr 2  30 40 40 40          .byte $30, $40, $40, $40, $3F
000981r 2  3F           
000982r 2                       ; $4B 'K'
000982r 2  7F 08 14 22          .byte $7F, $08, $14, $22, $41
000986r 2  41           
000987r 2                       ; $4C 'L'
000987r 2  7F 40 40 40          .byte $7F, $40, $40, $40, $40
00098Br 2  40           
00098Cr 2                       ; $4D 'M'
00098Cr 2  7F 02 04 02          .byte $7F, $02, $04, $02, $7F
000990r 2  7F           
000991r 2                       ; $4E 'N'
000991r 2  7F 02 0C 10          .byte $7F, $02, $0C, $10, $7F
000995r 2  7F           
000996r 2                       ; $4F 'O'
000996r 2  3E 41 41 41          .byte $3E, $41, $41, $41, $3E
00099Ar 2  3E           
00099Br 2                       ; $50 'P'
00099Br 2  7F 09 09 09          .byte $7F, $09, $09, $09, $06
00099Fr 2  06           
0009A0r 2                       ; $51 'Q'
0009A0r 2  3E 41 41 21          .byte $3E, $41, $41, $21, $5E
0009A4r 2  5E           
0009A5r 2                       ; $52 'R'
0009A5r 2  7F 09 19 29          .byte $7F, $09, $19, $29, $46
0009A9r 2  46           
0009AAr 2                       ; $53 'S'
0009AAr 2  46 49 49 49          .byte $46, $49, $49, $49, $31
0009AEr 2  31           
0009AFr 2                       ; $54 'T'
0009AFr 2  01 01 7F 01          .byte $01, $01, $7F, $01, $01
0009B3r 2  01           
0009B4r 2                       ; $55 'U'
0009B4r 2  3F 40 40 40          .byte $3F, $40, $40, $40, $3F
0009B8r 2  3F           
0009B9r 2                       ; $56 'V'
0009B9r 2  1F 20 40 20          .byte $1F, $20, $40, $20, $1F
0009BDr 2  1F           
0009BEr 2                       ; $57 'W'
0009BEr 2  3F 40 38 40          .byte $3F, $40, $38, $40, $3F
0009C2r 2  3F           
0009C3r 2                       ; $58 'X'
0009C3r 2  63 14 08 14          .byte $63, $14, $08, $14, $63
0009C7r 2  63           
0009C8r 2                       ; $59 'Y'
0009C8r 2  03 04 78 04          .byte $03, $04, $78, $04, $03
0009CCr 2  03           
0009CDr 2                       ; $5A 'Z'
0009CDr 2  61 51 49 45          .byte $61, $51, $49, $45, $43
0009D1r 2  43           
0009D2r 2               
0009D2r 1               .include "src/rng.asm"
0009D2r 2               ; =============================================================================
0009D2r 2               ;   rng.asm — local bootstrap RNG (to be replaced by 6502-Lib include)
0009D2r 2               ; =============================================================================
0009D2r 2               
0009D2r 2               .segment "CART"
0009D2r 2               
0009D2r 2               AdvanceRng:
0009D2r 2  A5 3C          lda RNG_STATE
0009D4r 2  4A             lsr a
0009D5r 2  90 02          bcc @noeor
0009D7r 2  49 B4          eor #$B4
0009D9r 2               @noeor:
0009D9r 2  85 3C          sta RNG_STATE
0009DBr 2  60             rts
0009DCr 2               
0009DCr 1               .include "src/input.asm"
0009DCr 2               ; =============================================================================
0009DCr 2               ;   input.asm — LightCycles input shim using 6502-Lib polling
0009DCr 2               ; =============================================================================
0009DCr 2               ;   Joystick-first, keyboard-fallback: PollInput (P1) and PollInputP2 each
0009DCr 2               ;   poll their own joystick port via 6502-Lib's PollJoy1/PollJoy2, and fall
0009DCr 2               ;   back to this tick's already-drained keyboard split (WASD=P1, arrows=P2)
0009DCr 2               ;   only when that player's joystick shows no direction at all this poll
0009DCr 2               ;   (including when no GPIO card is fitted). DrainKeyboardSplit is called
0009DCr 2               ;   exactly once per tick, from PollInput (which runs first in MainLoop),
0009DCr 2               ;   so PollInputP2 reuses the same drain window's KB_DIR_P2 result instead
0009DCr 2               ;   of re-draining an already-empty Chrin buffer.
0009DCr 2               ;
0009DCr 2               ;   A bike always advances forward every tick regardless of input — turning
0009DCr 2               ;   is a discrete heading change, not something that needs to be held to
0009DCr 2               ;   keep moving — so unlike Pong's paddles, no hold/decay layer is needed
0009DCr 2               ;   here: DrainKeyboardSplit's per-tick "last direction seen" result is the
0009DCr 2               ;   same sticky-until-changed semantics the joystick-only code already had.
0009DCr 2               ; =============================================================================
0009DCr 2               
0009DCr 2               .include "../../6502-Lib/include/input.inc"
0009DCr 3               ; =============================================================================
0009DCr 3               ;   input.inc — interface contract for shared joystick-first input polling
0009DCr 3               ; =============================================================================
0009DCr 3               ;
0009DCr 3               ; Required caller symbols (defined by the consuming project before this
0009DCr 3               ; file is .include-d):
0009DCr 3               ;   HW_PRESENT, HW_GPIO, ReadJoystick1, ReadJoystick2, Chrin  ; Kernal
0009DCr 3               ;   DIR_UP, DIR_DOWN                        ; caller's own numeric values
0009DCr 3               ;   DIR_LEFT, DIR_RIGHT                     ; omit both for a 2-directional
0009DCr 3               ;                                            ; game (e.g. Pong) — LEFT/RIGHT
0009DCr 3               ;                                            ; checks compile out
0009DCr 3               ;   JOY_STATE                               ; zero page, for PollJoyCombined
0009DCr 3               ;                                            ; and PollJoy1
0009DCr 3               ;   JOY_STATE2                              ; zero page, for PollJoy2
0009DCr 3               ;   KB_DIR, KB_FIRE                         ; zero page, for
0009DCr 3               ;                                            ; DrainKeyboardCombined
0009DCr 3               ;   KB_DIR_P1, KB_DIR_P2, KB_FIRE           ; zero page, for
0009DCr 3               ;   KB_FIRE_P1, KB_FIRE_P2                  ; DrainKeyboardSplit
0009DCr 3               ;                                            ; (KB_FIRE_P1/P2 only needed
0009DCr 3               ;                                            ; by a caller that wants
0009DCr 3               ;                                            ; independent per-player fire
0009DCr 3               ;                                            ; — every game as of this
0009DCr 3               ;                                            ; writing uses the combined
0009DCr 3               ;                                            ; KB_FIRE instead)
0009DCr 3               ;
0009DCr 3               ; Exported routines:
0009DCr 3               ;   PollJoyCombined       both joystick ports AND-combined (single-player)
0009DCr 3               ;   PollJoy1 / PollJoy2   one joystick port, gated on HW_GPIO
0009DCr 3               ;   DrainKeyboardCombined single-player keyboard fallback (WASD or arrows)
0009DCr 3               ;   DrainKeyboardSplit    two-player keyboard fallback (WASD=P1, arrows=P2)
0009DCr 3               ;
0009DCr 3               ; Fire keys: space (KEY_FIRE) is P1's/the single-player fallback; enter
0009DCr 3               ; (KEY_FIRE2) is P2's. DrainKeyboardCombined accepts either interchangeably
0009DCr 3               ; into one KB_FIRE flag. DrainKeyboardSplit sets both the combined KB_FIRE
0009DCr 3               ; (either key, for today's shared start/pause/confirm actions) and the
0009DCr 3               ; per-player KB_FIRE_P1/KB_FIRE_P2 (for a future game with independent
0009DCr 3               ; per-player fire, e.g. a two-player shooter).
0009DCr 3               ;
0009DCr 3               ; Priority rule every caller composes for itself (see docs/INPUT.md):
0009DCr 3               ;   Joystick first. If the joystick shows a direction this poll, use it and
0009DCr 3               ;   ignore the keyboard entirely this poll. Only consult the keyboard's
0009DCr 3               ;   drained result when the joystick shows nothing. The fire/A button is
0009DCr 3               ;   OR'd (joystick A or keyboard space, either triggers), independent of
0009DCr 3               ;   the direction priority.
0009DCr 3               ; =============================================================================
0009DCr 3               
0009DCr 2               .include "../../6502-Lib/core/input.asm"
0009DCr 3               ; =============================================================================
0009DCr 3               ;   input.asm — shared joystick-first, keyboard-fallback input primitives
0009DCr 3               ; =============================================================================
0009DCr 3               ; Caller contract:
0009DCr 3               ; - Consuming project defines HW_PRESENT, HW_GPIO, ReadJoystick1,
0009DCr 3               ;   ReadJoystick2, Chrin (all Kernal-provided) before including this file.
0009DCr 3               ; - Consuming project defines its own DIR_UP/DIR_DOWN constants (and
0009DCr 3               ;   DIR_LEFT/DIR_RIGHT, only if it's a 4-directional game) at whatever
0009DCr 3               ;   numeric values it already uses — this file references them by name
0009DCr 3               ;   only, so Snake/LightCycles' 0/1/2/3 and Pong's 1/2 both work unchanged.
0009DCr 3               ; - Consuming project defines the zero-page output bytes each routine
0009DCr 3               ;   below documents (JOY_STATE, JOY_STATE2, KB_DIR, KB_DIR_P1, KB_DIR_P2,
0009DCr 3               ;   KB_FIRE, and — only if calling DrainKeyboardSplit — KB_FIRE_P1,
0009DCr 3               ;   KB_FIRE_P2) before including this file, at whatever address is free.
0009DCr 3               ;
0009DCr 3               ; Exported routines:
0009DCr 3               ; - PollJoyCombined      both ports AND-combined (single-player, either port)
0009DCr 3               ; - PollJoy1 / PollJoy2  a single port, gated on HW_GPIO
0009DCr 3               ; - DrainKeyboardCombined  single-player keyboard fallback (WASD or arrows)
0009DCr 3               ; - DrainKeyboardSplit     two-player keyboard fallback (WASD=P1, arrows=P2)
0009DCr 3               ;
0009DCr 3               ; This file intentionally does NOT resolve a final NEXT_DIR/START_PRESSED —
0009DCr 3               ; that composition (joystick-first priority, A-button-or-space, edge
0009DCr 3               ; detection) is project-specific glue that stays in each game's own
0009DCr 3               ; input.asm, since the exact target variables differ per game (NEXT_DIR vs
0009DCr 3               ; NEXT_P1/NEXT_P2, single-player vs split). See docs/INPUT.md for the
0009DCr 3               ; priority rule every caller should follow.
0009DCr 3               ; =============================================================================
0009DCr 3               
0009DCr 3               ; --- Joystick bits (active-low on the wire: 0 = pressed) ---
0009DCr 3               JOY_A     = %00000001
0009DCr 3               JOY_B     = %00000010
0009DCr 3               JOY_X     = %00000100
0009DCr 3               JOY_Y     = %00001000
0009DCr 3               JOY_UP    = %00010000
0009DCr 3               JOY_DOWN  = %00100000
0009DCr 3               JOY_LEFT  = %01000000
0009DCr 3               JOY_RIGHT = %10000000
0009DCr 3               
0009DCr 3               ; --- Keyboard fallback scancodes ---
0009DCr 3               ; Kernal delivers uppercase ASCII for letter keys; arrow keys are control
0009DCr 3               ; codes, not printable characters.
0009DCr 3               KEY_W           = 'W'
0009DCr 3               KEY_A           = 'A'
0009DCr 3               KEY_S           = 'S'
0009DCr 3               KEY_D           = 'D'
0009DCr 3               KEY_UP_ARROW    = $1E
0009DCr 3               KEY_DOWN_ARROW  = $1F
0009DCr 3               KEY_LEFT_ARROW  = $1C
0009DCr 3               KEY_RIGHT_ARROW = $1D
0009DCr 3               KEY_FIRE        = ' '     ; space bar: P1's fire fallback (thumb-reachable
0009DCr 3                                          ; from WASD's resting position; also the
0009DCr 3                                          ; traditional single-player shooter fire key)
0009DCr 3               KEY_FIRE2       = $0D     ; enter/return (CHAR_CR): P2's fire fallback,
0009DCr 3                                          ; sits right next to the arrow-key cluster on
0009DCr 3                                          ; nearly every layout. Deliberately not a
0009DCr 3                                          ; modifier key (Ctrl/Shift) -- Chrin is a plain
0009DCr 3                                          ; character buffer, and modifier keys generally
0009DCr 3                                          ; don't produce their own readable character,
0009DCr 3                                          ; nor could left/right variants be told apart
0009DCr 3                                          ; even if they did.
0009DCr 3               
0009DCr 3               KB_DIR_NONE = $FF          ; sentinel: no direction seen in this drain
0009DCr 3               
0009DCr 3               .segment "CART"
0009DCr 3               
0009DCr 3               ; -----------------------------------------------------------------------------
0009DCr 3               ; PollJoyCombined — read both joystick ports and AND-combine them
0009DCr 3               ; (active-low AND = logical OR of "pressed"), so either port drives a
0009DCr 3               ; single-player game regardless of which one it's plugged into.
0009DCr 3               ; Out: JOY_STATE = combined active-low byte, or $FF (idle) if no GPIO card.
0009DCr 3               ; Clobbers: A
0009DCr 3               ; -----------------------------------------------------------------------------
0009DCr 3               PollJoyCombined:
0009DCr 3  AD 0D 03       lda HW_PRESENT
0009DFr 3  29 20          and #HW_GPIO
0009E1r 3  D0 05          bne @haveGpio
0009E3r 3  A9 FF          lda #$FF
0009E5r 3  85 3E          sta JOY_STATE
0009E7r 3  60             rts
0009E8r 3               @haveGpio:
0009E8r 3  20 48 A0       jsr ReadJoystick1
0009EBr 3  85 3E          sta JOY_STATE
0009EDr 3  20 4B A0       jsr ReadJoystick2
0009F0r 3  25 3E          and JOY_STATE
0009F2r 3  85 3E          sta JOY_STATE
0009F4r 3  60             rts
0009F5r 3               
0009F5r 3               ; -----------------------------------------------------------------------------
0009F5r 3               ; PollJoy1 / PollJoy2 — read a single joystick port, gated on HW_GPIO
0009F5r 3               ; (ReadJoystick1/2 do not check hardware presence themselves — a floating
0009F5r 3               ; bus reads as meaningless data with no GPIO card fitted).
0009F5r 3               ; Out: JOY_STATE / JOY_STATE2, or $FF (idle) if no GPIO card.
0009F5r 3               ; Clobbers: A
0009F5r 3               ; -----------------------------------------------------------------------------
0009F5r 3               PollJoy1:
0009F5r 3  AD 0D 03       lda HW_PRESENT
0009F8r 3  29 20          and #HW_GPIO
0009FAr 3  D0 05          bne @haveGpio
0009FCr 3  A9 FF          lda #$FF
0009FEr 3  85 3E          sta JOY_STATE
000A00r 3  60             rts
000A01r 3               @haveGpio:
000A01r 3  20 48 A0       jsr ReadJoystick1
000A04r 3  85 3E          sta JOY_STATE
000A06r 3  60             rts
000A07r 3               
000A07r 3               PollJoy2:
000A07r 3  AD 0D 03       lda HW_PRESENT
000A0Ar 3  29 20          and #HW_GPIO
000A0Cr 3  D0 05          bne @haveGpio
000A0Er 3  A9 FF          lda #$FF
000A10r 3  85 4F          sta JOY_STATE2
000A12r 3  60             rts
000A13r 3               @haveGpio:
000A13r 3  20 4B A0       jsr ReadJoystick2
000A16r 3  85 4F          sta JOY_STATE2
000A18r 3  60             rts
000A19r 3               
000A19r 3               ; -----------------------------------------------------------------------------
000A19r 3               ; DrainKeyboardCombined — single-player keyboard fallback: WASD or arrow
000A19r 3               ; keys both work, whichever was pressed most recently in this call wins.
000A19r 3               ; Drains every pending Chrin character each call (not just one), so a
000A19r 3               ; burst typed between polls doesn't leave stale characters for next time.
000A19r 3               ; LEFT/RIGHT checks compile out entirely for a 2-directional caller that
000A19r 3               ; never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
000A19r 3               ; Out: KB_DIR = last recognized direction this call, or KB_DIR_NONE.
000A19r 3               ;      KB_FIRE = 1 if space or enter was seen this call, else 0. Both
000A19r 3               ;      fire keys work interchangeably here, matching how WASD and arrows
000A19r 3               ;      both work interchangeably for movement in this single-player case.
000A19r 3               ; Clobbers: A
000A19r 3               ; -----------------------------------------------------------------------------
000A19r 3               DrainKeyboardCombined:
000A19r 3  A9 FF          lda #KB_DIR_NONE
000A1Br 3  85 6C          sta KB_DIR
000A1Dr 3  64 6A          stz KB_FIRE
000A1Fr 3               @drain:
000A1Fr 3  20 03 A0       jsr Chrin
000A22r 3  90 4B          bcc @done                 ; C=0 = no character waiting, buffer empty
000A24r 3                                            ; (Chrin signals this via carry, NOT via A=0 --
000A24r 3                                            ; A holds a character even when C=0 is possible,
000A24r 3                                            ; so checking A for zero here would loop forever)
000A24r 3               
000A24r 3  C9 57          cmp #KEY_W
000A26r 3  F0 2B          beq @setUp
000A28r 3  C9 1E          cmp #KEY_UP_ARROW
000A2Ar 3  F0 27          beq @setUp
000A2Cr 3  C9 53          cmp #KEY_S
000A2Er 3  F0 2A          beq @setDown
000A30r 3  C9 1F          cmp #KEY_DOWN_ARROW
000A32r 3  F0 26          beq @setDown
000A34r 3               .ifdef DIR_LEFT
000A34r 3  C9 41          cmp #KEY_A
000A36r 3  F0 29          beq @setLeft
000A38r 3  C9 1C          cmp #KEY_LEFT_ARROW
000A3Ar 3  F0 25          beq @setLeft
000A3Cr 3               .endif
000A3Cr 3               .ifdef DIR_RIGHT
000A3Cr 3  C9 44          cmp #KEY_D
000A3Er 3  F0 28          beq @setRight
000A40r 3  C9 1D          cmp #KEY_RIGHT_ARROW
000A42r 3  F0 24          beq @setRight
000A44r 3               .endif
000A44r 3  C9 20          cmp #KEY_FIRE
000A46r 3  F0 04          beq @setFire
000A48r 3  C9 0D          cmp #KEY_FIRE2
000A4Ar 3  D0 D3          bne @drain
000A4Cr 3               @setFire:
000A4Cr 3  A9 01          lda #1
000A4Er 3  85 6A          sta KB_FIRE
000A50r 3  4C rr rr       jmp @drain
000A53r 3               
000A53r 3               @setUp:
000A53r 3  A9 00          lda #DIR_UP
000A55r 3  85 6C          sta KB_DIR
000A57r 3  4C rr rr       jmp @drain
000A5Ar 3               @setDown:
000A5Ar 3  A9 01          lda #DIR_DOWN
000A5Cr 3  85 6C          sta KB_DIR
000A5Er 3  4C rr rr       jmp @drain
000A61r 3               .ifdef DIR_LEFT
000A61r 3               @setLeft:
000A61r 3  A9 02          lda #DIR_LEFT
000A63r 3  85 6C          sta KB_DIR
000A65r 3  4C rr rr       jmp @drain
000A68r 3               .endif
000A68r 3               .ifdef DIR_RIGHT
000A68r 3               @setRight:
000A68r 3  A9 03          lda #DIR_RIGHT
000A6Ar 3  85 6C          sta KB_DIR
000A6Cr 3  4C rr rr       jmp @drain
000A6Fr 3               .endif
000A6Fr 3               
000A6Fr 3               @done:
000A6Fr 3  60             rts
000A70r 3               
000A70r 3               ; -----------------------------------------------------------------------------
000A70r 3               ; DrainKeyboardSplit — two-player keyboard fallback: WASD drives P1 only,
000A70r 3               ; arrow keys drive P2 only, so one player's keypresses can never move the
000A70r 3               ; other's paddle/cycle. Drains every pending Chrin character ONCE per
000A70r 3               ; call, checking both keysets in the same pass (so both players' presses
000A70r 3               ; in the same drain window are captured, not just whichever keyset was
000A70r 3               ; checked first). LEFT/RIGHT checks compile out for a 2-directional caller
000A70r 3               ; that never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
000A70r 3               ; Out: KB_DIR_P1 = last WASD direction seen this call, or KB_DIR_NONE.
000A70r 3               ;      KB_DIR_P2 = last arrow-key direction seen this call, or KB_DIR_NONE.
000A70r 3               ;      KB_FIRE = 1 if EITHER fire key was seen this call, else 0 — kept
000A70r 3               ;      for callers with only one shared fire/start/pause action (every
000A70r 3               ;      game as of this writing: "did anyone press it" is all that
000A70r 3               ;      matters, mirroring how either joystick's A button already
000A70r 3               ;      triggers the same shared action today).
000A70r 3               ;      KB_FIRE_P1 = 1 if space (P1's fire key) was seen this call, else 0.
000A70r 3               ;      KB_FIRE_P2 = 1 if enter (P2's fire key) was seen this call, else 0.
000A70r 3               ;      A future game with independent per-player fire (e.g. a two-player
000A70r 3               ;      shooter) reads KB_FIRE_P1/KB_FIRE_P2 instead of the combined flag.
000A70r 3               ; Clobbers: A
000A70r 3               ; -----------------------------------------------------------------------------
000A70r 3               DrainKeyboardSplit:
000A70r 3  A9 FF          lda #KB_DIR_NONE
000A72r 3  85 68          sta KB_DIR_P1
000A74r 3  85 69          sta KB_DIR_P2
000A76r 3  64 6A          stz KB_FIRE
000A78r 3  64 6D          stz KB_FIRE_P1
000A7Ar 3  64 6E          stz KB_FIRE_P2
000A7Cr 3               @drain:
000A7Cr 3  20 03 A0       jsr Chrin
000A7Fr 3  90 72          bcc @done                 ; C=0 = no character waiting, buffer empty
000A81r 3                                            ; (Chrin signals this via carry, NOT via A=0)
000A81r 3               
000A81r 3  C9 57          cmp #KEY_W
000A83r 3  F0 36          beq @p1Up
000A85r 3  C9 53          cmp #KEY_S
000A87r 3  F0 39          beq @p1Down
000A89r 3               .ifdef DIR_LEFT
000A89r 3  C9 41          cmp #KEY_A
000A8Br 3  F0 3C          beq @p1Left
000A8Dr 3               .endif
000A8Dr 3               .ifdef DIR_RIGHT
000A8Dr 3  C9 44          cmp #KEY_D
000A8Fr 3  F0 3F          beq @p1Right
000A91r 3               .endif
000A91r 3  C9 1E          cmp #KEY_UP_ARROW
000A93r 3  F0 42          beq @p2Up
000A95r 3  C9 1F          cmp #KEY_DOWN_ARROW
000A97r 3  F0 45          beq @p2Down
000A99r 3               .ifdef DIR_LEFT
000A99r 3  C9 1C          cmp #KEY_LEFT_ARROW
000A9Br 3  F0 48          beq @p2Left
000A9Dr 3               .endif
000A9Dr 3               .ifdef DIR_RIGHT
000A9Dr 3  C9 1D          cmp #KEY_RIGHT_ARROW
000A9Fr 3  F0 4B          beq @p2Right
000AA1r 3               .endif
000AA1r 3  C9 20          cmp #KEY_FIRE
000AA3r 3  F0 0D          beq @p1Fire
000AA5r 3  C9 0D          cmp #KEY_FIRE2
000AA7r 3  D0 D3          bne @drain
000AA9r 3  A9 01          lda #1
000AABr 3  85 6A          sta KB_FIRE
000AADr 3  85 6E          sta KB_FIRE_P2
000AAFr 3  4C rr rr       jmp @drain
000AB2r 3               @p1Fire:
000AB2r 3  A9 01          lda #1
000AB4r 3  85 6A          sta KB_FIRE
000AB6r 3  85 6D          sta KB_FIRE_P1
000AB8r 3  4C rr rr       jmp @drain
000ABBr 3               
000ABBr 3               @p1Up:
000ABBr 3  A9 00          lda #DIR_UP
000ABDr 3  85 68          sta KB_DIR_P1
000ABFr 3  4C rr rr       jmp @drain
000AC2r 3               @p1Down:
000AC2r 3  A9 01          lda #DIR_DOWN
000AC4r 3  85 68          sta KB_DIR_P1
000AC6r 3  4C rr rr       jmp @drain
000AC9r 3               .ifdef DIR_LEFT
000AC9r 3               @p1Left:
000AC9r 3  A9 02          lda #DIR_LEFT
000ACBr 3  85 68          sta KB_DIR_P1
000ACDr 3  4C rr rr       jmp @drain
000AD0r 3               .endif
000AD0r 3               .ifdef DIR_RIGHT
000AD0r 3               @p1Right:
000AD0r 3  A9 03          lda #DIR_RIGHT
000AD2r 3  85 68          sta KB_DIR_P1
000AD4r 3  4C rr rr       jmp @drain
000AD7r 3               .endif
000AD7r 3               @p2Up:
000AD7r 3  A9 00          lda #DIR_UP
000AD9r 3  85 69          sta KB_DIR_P2
000ADBr 3  4C rr rr       jmp @drain
000ADEr 3               @p2Down:
000ADEr 3  A9 01          lda #DIR_DOWN
000AE0r 3  85 69          sta KB_DIR_P2
000AE2r 3  4C rr rr       jmp @drain
000AE5r 3               .ifdef DIR_LEFT
000AE5r 3               @p2Left:
000AE5r 3  A9 02          lda #DIR_LEFT
000AE7r 3  85 69          sta KB_DIR_P2
000AE9r 3  4C rr rr       jmp @drain
000AECr 3               .endif
000AECr 3               .ifdef DIR_RIGHT
000AECr 3               @p2Right:
000AECr 3  A9 03          lda #DIR_RIGHT
000AEEr 3  85 69          sta KB_DIR_P2
000AF0r 3  4C rr rr       jmp @drain
000AF3r 3               .endif
000AF3r 3               
000AF3r 3               @done:
000AF3r 3  60             rts
000AF4r 3               
000AF4r 2               
000AF4r 2               ; -----------------------------------------------------------------------------
000AF4r 2               ; PollInput — P1: joystick 1 first, WASD fallback when idle. Also drains
000AF4r 2               ; the keyboard (once, for both players) and ORs joystick A / space into
000AF4r 2               ; START_PRESSED, independent of the direction priority.
000AF4r 2               ; -----------------------------------------------------------------------------
000AF4r 2               PollInput:
000AF4r 2  64 4C        	stz START_PRESSED
000AF6r 2               
000AF6r 2  20 rr rr     	jsr PollJoy1
000AF9r 2  20 rr rr     	jsr DrainKeyboardSplit
000AFCr 2               
000AFCr 2  A5 3E        	lda JOY_STATE
000AFEr 2  29 F0        	and #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
000B00r 2  C9 F0        	cmp #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
000B02r 2  F0 2B        	beq @kbDir                ; joystick idle on all 4 directions -> fallback
000B04r 2               
000B04r 2  A5 3E        	lda JOY_STATE
000B06r 2  29 10        	and #JOY_UP
000B08r 2  D0 04        	bne @jNotUp
000B0Ar 2  A9 00        	lda #DIR_UP
000B0Cr 2  85 43        	sta NEXT_DIR
000B0Er 2               @jNotUp:
000B0Er 2  A5 3E        	lda JOY_STATE
000B10r 2  29 20        	and #JOY_DOWN
000B12r 2  D0 04        	bne @jNotDown
000B14r 2  A9 01        	lda #DIR_DOWN
000B16r 2  85 43        	sta NEXT_DIR
000B18r 2               @jNotDown:
000B18r 2  A5 3E        	lda JOY_STATE
000B1Ar 2  29 40        	and #JOY_LEFT
000B1Cr 2  D0 04        	bne @jNotLeft
000B1Er 2  A9 02        	lda #DIR_LEFT
000B20r 2  85 43        	sta NEXT_DIR
000B22r 2               @jNotLeft:
000B22r 2  A5 3E        	lda JOY_STATE
000B24r 2  29 80        	and #JOY_RIGHT
000B26r 2  D0 04        	bne @jNotRight
000B28r 2  A9 03        	lda #DIR_RIGHT
000B2Ar 2  85 43        	sta NEXT_DIR
000B2Cr 2               @jNotRight:
000B2Cr 2  4C rr rr     	jmp @doneDir
000B2Fr 2               
000B2Fr 2               @kbDir:
000B2Fr 2  A5 68        	lda KB_DIR_P1
000B31r 2  C9 FF        	cmp #KB_DIR_NONE
000B33r 2  F0 02        	beq @doneDir
000B35r 2  85 43        	sta NEXT_DIR
000B37r 2               @doneDir:
000B37r 2               
000B37r 2               	; Fire/A: OR'd independently of direction priority — joystick A held
000B37r 2               	; OR keyboard space seen this drain, either sets START_PRESSED.
000B37r 2  A5 3E        	lda JOY_STATE
000B39r 2  29 01        	and #JOY_A
000B3Br 2  D0 07        	bne @checkKbFire
000B3Dr 2  A9 01        	lda #1
000B3Fr 2  85 4C        	sta START_PRESSED
000B41r 2  4C rr rr     	jmp @doneFire
000B44r 2               @checkKbFire:
000B44r 2  A5 6A        	lda KB_FIRE
000B46r 2  F0 04        	beq @doneFire
000B48r 2  A9 01        	lda #1
000B4Ar 2  85 4C        	sta START_PRESSED
000B4Cr 2               @doneFire:
000B4Cr 2               
000B4Cr 2  A9 00        	lda #$00
000B4Er 2  85 4D        	sta FIRE_EDGE
000B50r 2  A5 3F        	lda PREV_FIRE
000B52r 2  D0 06        	bne @noEdge
000B54r 2  A5 4C        	lda START_PRESSED
000B56r 2  F0 02        	beq @noEdge
000B58r 2  E6 4D        	inc FIRE_EDGE
000B5Ar 2               @noEdge:
000B5Ar 2  A5 4C        	lda START_PRESSED
000B5Cr 2  85 3F        	sta PREV_FIRE
000B5Er 2  60           	rts
000B5Fr 2               
000B5Fr 2               ; -----------------------------------------------------------------------------
000B5Fr 2               ; PollInputP2 — P2: joystick 2 first, arrow-key fallback when idle. Always
000B5Fr 2               ; polled, regardless of GAME_MODE -- this used to be gated on
000B5Fr 2               ; GAME_MODE == MODE_2P (skip reading a controller nothing in 1P mode would
000B5Fr 2               ; use), but that gate ran on the title screen too, where GAME_MODE reflects
000B5Fr 2               ; whichever mode happens to be currently selected rather than "are we
000B5Fr 2               ; actually playing 1P". With 1P as the default, that meant JOY_STATE2 was
000B5Fr 2               ; never written at all while sitting on the title screen -- left at
000B5Fr 2               ; whatever garbage was in RAM at boot ($00, which reads as every direction
000B5Fr 2               ; held at once) -- and SetModeFromInput/HandleColorPicker read that as a
000B5Fr 2               ; real button press, silently flipping GAME_MODE the instant the title
000B5Fr 2               ; screen loaded. Safe to always poll: during actual 1P gameplay,
000B5Fr 2               ; ComputeP2AIDirection unconditionally overwrites P2_NEXT_DIR right after
000B5Fr 2               ; this runs, on every one of its exit paths, so whatever a real (or
000B5Fr 2               ; absent) P2 controller reports here never survives to affect anything.
000B5Fr 2               ; Reuses KB_DIR_P2 from the DrainKeyboardSplit call PollInput already made
000B5Fr 2               ; this tick.
000B5Fr 2               ; -----------------------------------------------------------------------------
000B5Fr 2               PollInputP2:
000B5Fr 2  20 rr rr     	jsr PollJoy2
000B62r 2               
000B62r 2  A5 4F        	lda JOY_STATE2
000B64r 2  29 F0        	and #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
000B66r 2  C9 F0        	cmp #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
000B68r 2  F0 29        	beq @kbDir                ; joystick idle on all 4 directions -> fallback
000B6Ar 2               
000B6Ar 2  A5 4F        	lda JOY_STATE2
000B6Cr 2  29 10        	and #JOY_UP
000B6Er 2  D0 04        	bne @notUp
000B70r 2  A9 00        	lda #DIR_UP
000B72r 2  85 48        	sta P2_NEXT_DIR
000B74r 2               @notUp:
000B74r 2  A5 4F        	lda JOY_STATE2
000B76r 2  29 20        	and #JOY_DOWN
000B78r 2  D0 04        	bne @notDown
000B7Ar 2  A9 01        	lda #DIR_DOWN
000B7Cr 2  85 48        	sta P2_NEXT_DIR
000B7Er 2               @notDown:
000B7Er 2  A5 4F        	lda JOY_STATE2
000B80r 2  29 40        	and #JOY_LEFT
000B82r 2  D0 04        	bne @notLeft
000B84r 2  A9 02        	lda #DIR_LEFT
000B86r 2  85 48        	sta P2_NEXT_DIR
000B88r 2               @notLeft:
000B88r 2  A5 4F        	lda JOY_STATE2
000B8Ar 2  29 80        	and #JOY_RIGHT
000B8Cr 2  D0 0D        	bne @done
000B8Er 2  A9 03        	lda #DIR_RIGHT
000B90r 2  85 48        	sta P2_NEXT_DIR
000B92r 2  60           	rts
000B93r 2               
000B93r 2               @kbDir:
000B93r 2  A5 69        	lda KB_DIR_P2
000B95r 2  C9 FF        	cmp #KB_DIR_NONE
000B97r 2  F0 02        	beq @done
000B99r 2  85 48        	sta P2_NEXT_DIR
000B9Br 2               @done:
000B9Br 2  60           	rts
000B9Cr 2               
000B9Cr 1               .include "src/sound.asm"
000B9Cr 2               ; =============================================================================
000B9Cr 2               ;   sound.asm — sound hook skeleton for LightCycles
000B9Cr 2               ; =============================================================================
000B9Cr 2               
000B9Cr 2               .segment "CART"
000B9Cr 2               
000B9Cr 2               Sound_Service:
000B9Cr 2                 ; TODO: add deferred SID silence handling if used.
000B9Cr 2  60             rts
000B9Dr 2               
000B9Dr 1               .include "src/game.asm"
000B9Dr 2               ; =============================================================================
000B9Dr 2               ;   game.asm — pixel-precision LightCycles game loop
000B9Dr 2               ; =============================================================================
000B9Dr 2               
000B9Dr 2               .segment "CART"
000B9Dr 2               
000B9Dr 2               NewGame:
000B9Dr 2  A9 00          lda #MODE_1P
000B9Fr 2  85 3B          sta GAME_MODE
000BA1r 2  A9 04          lda #4                    ; TrailFgColorTable[4] = LT_BLUE
000BA3r 2  85 62          sta P1_COLOR_IDX
000BA5r 2  A9 01          lda #1                    ; TrailFgColorTable[1] = LT_YELLOW
000BA7r 2  85 63          sta P2_COLOR_IDX
000BA9r 2  64 66          stz MENU_P1_PREV
000BABr 2  64 67          stz MENU_P2_PREV
000BADr 2  64 80          stz MENU_MODE_PREV
000BAFr 2  20 rr rr       jsr ApplySelectedTrailColors
000BB2r 2  A9 2A          lda #$2A
000BB4r 2  85 3C          sta RNG_STATE
000BB6r 2  20 rr rr       jsr DrawTitleScreen
000BB9r 2  60             rts
000BBAr 2               
000BBAr 2               Tick:
000BBAr 2  A5 3A          lda GAME_STATE
000BBCr 2  C9 00          cmp #STATE_TITLE
000BBEr 2  D0 03          bne :+
000BC0r 2  4C rr rr       jmp TickTitle
000BC3r 2               :
000BC3r 2  C9 01          cmp #STATE_PLAYING
000BC5r 2  D0 03          bne :+
000BC7r 2  4C rr rr       jmp TickPlaying
000BCAr 2               :
000BCAr 2  C9 04          cmp #STATE_PAUSED
000BCCr 2  D0 03          bne :+
000BCEr 2  4C rr rr       jmp TickPaused
000BD1r 2               :
000BD1r 2  C9 03          cmp #STATE_GAMEOVER
000BD3r 2  D0 03          bne :+
000BD5r 2  4C rr rr       jmp TickGameOver
000BD8r 2               :
000BD8r 2  4C rr rr       jmp TickDone
000BDBr 2               
000BDBr 2               TickTitle:
000BDBr 2  20 rr rr       jsr HandleColorPicker
000BDEr 2  20 rr rr       jsr SetModeFromInput
000BE1r 2  20 rr rr       jsr DrawModeLine
000BE4r 2  20 rr rr       jsr DrawColorLines
000BE7r 2  A5 4D          lda FIRE_EDGE
000BE9r 2  D0 03          bne :+
000BEBr 2  4C rr rr       jmp TickDone
000BEEr 2               :
000BEEr 2  20 rr rr       jsr StartRound
000BF1r 2  60             rts
000BF2r 2               
000BF2r 2               TickGameOver:
000BF2r 2  A5 4D          lda FIRE_EDGE
000BF4r 2  D0 03          bne :+
000BF6r 2  4C rr rr       jmp TickDone
000BF9r 2               :
000BF9r 2  20 rr rr       jsr DrawTitleScreen
000BFCr 2  60             rts
000BFDr 2               
000BFDr 2               TickPaused:
000BFDr 2  A5 4D          lda FIRE_EDGE
000BFFr 2  D0 03          bne :+
000C01r 2  4C rr rr       jmp TickDone
000C04r 2               :
000C04r 2  A9 01          lda #STATE_PLAYING
000C06r 2  85 3A          sta GAME_STATE
000C08r 2  60             rts
000C09r 2               
000C09r 2               TickPlaying:
000C09r 2  A5 4D          lda FIRE_EDGE
000C0Br 2  F0 05          beq @playAdvance
000C0Dr 2  A9 04          lda #STATE_PAUSED
000C0Fr 2  85 3A          sta GAME_STATE
000C11r 2  60             rts
000C12r 2               
000C12r 2               @playAdvance:
000C12r 2  A5 3B          lda GAME_MODE
000C14r 2  C9 00          cmp #MODE_1P
000C16r 2  D0 03          bne @skipAi
000C18r 2  20 rr rr       jsr ComputeP2AIDirection
000C1Br 2               @skipAi:
000C1Br 2               
000C1Br 2  20 rr rr       jsr ApplyRequestedTurns
000C1Er 2               
000C1Er 2  20 rr rr       jsr ComputeNextPositions
000C21r 2               
000C21r 2  A5 56          lda P1_NEXT_X
000C23r 2  C5 58          cmp P2_NEXT_X
000C25r 2  D0 0D          bne @notHeadOn
000C27r 2  A5 57          lda P1_NEXT_Y
000C29r 2  C5 59          cmp P2_NEXT_Y
000C2Br 2  D0 07          bne @notHeadOn
000C2Dr 2  64 44          stz P1_ALIVE
000C2Fr 2  64 49          stz P2_ALIVE
000C31r 2  4C rr rr       jmp ResolveRound
000C34r 2               
000C34r 2               ; Collision is purely "is this pixel's bit already set" (PixelIsSet) --
000C34r 2               ; it used to also require PixelColorCompatible (the target's TMS9918
000C34r 2               ; color-table byte being empty or already this player's color) before
000C34r 2               ; ruling a move safe. That byte is shared by all 8 horizontal pixels on
000C34r 2               ; a scanline, not just the one being tested, so an entirely untouched
000C34r 2               ; pixel could still read "incompatible" -- and therefore die -- just for
000C34r 2               ; sitting in the same 8-pixel group as an unrelated, different-colored
000C34r 2               ; trail a few columns away with nothing actually touching. Confirmed via
000C34r 2               ; the debugger: PixelIsSet(50,99)=clear (genuinely empty) yet
000C34r 2               ; PixelColorCompatible(50,99, a second color) still reported incompatible
000C34r 2               ; after only column 96 -- same group, different pixel -- had been drawn.
000C34r 2               @notHeadOn:
000C34r 2  A5 57          lda P1_NEXT_Y
000C36r 2  C9 C0          cmp #192
000C38r 2  B0 07          bcs P1CollisionDead
000C3Ar 2  A6 56          ldx P1_NEXT_X
000C3Cr 2  20 rr rr       jsr PixelIsSet
000C3Fr 2  F0 02          beq P1CollisionClear
000C41r 2               P1CollisionDead:
000C41r 2  64 44          stz P1_ALIVE
000C43r 2               P1CollisionClear:
000C43r 2               
000C43r 2  A5 59          lda P2_NEXT_Y
000C45r 2  C9 C0          cmp #192
000C47r 2  B0 07          bcs P2CollisionDead
000C49r 2  A6 58          ldx P2_NEXT_X
000C4Br 2  20 rr rr       jsr PixelIsSet
000C4Er 2  F0 02          beq P2CollisionClear
000C50r 2               P2CollisionDead:
000C50r 2  64 49          stz P2_ALIVE
000C52r 2               P2CollisionClear:
000C52r 2               
000C52r 2               ResolveRound:
000C52r 2  A5 44          lda P1_ALIVE
000C54r 2  F0 0E          beq ResolveP1Dead
000C56r 2  A5 49          lda P2_ALIVE
000C58r 2  F0 1D          beq ResolveP2DeadOnly
000C5Ar 2               
000C5Ar 2  20 rr rr       jsr CommitP1Move
000C5Dr 2  20 rr rr       jsr CommitP2Move
000C60r 2  20 rr rr       jsr UpdateHeadSprites
000C63r 2  60             rts
000C64r 2               
000C64r 2               ResolveP1Dead:
000C64r 2  A5 49          lda P2_ALIVE
000C66r 2  F0 1E          beq ResolveBothDead
000C68r 2  A9 02          lda #2                   ; P1 crashed -> P2 wins (ROUND_RESULT names the
000C6Ar 2  85 61          sta ROUND_RESULT           ; WINNER, not who died -- this was backwards
000C6Cr 2                                             ; before: P1 dying set ROUND_RESULT=1, which
000C6Cr 2                                             ; DrawGameOverScreen reads as "P1 wins"
000C6Cr 2  A9 03          lda #STATE_GAMEOVER
000C6Er 2  85 3A          sta GAME_STATE
000C70r 2  20 30 A0       jsr Beep
000C73r 2  20 rr rr       jsr DrawGameOverScreen
000C76r 2  60             rts
000C77r 2               
000C77r 2               ResolveP2DeadOnly:
000C77r 2  A9 01          lda #1                   ; P2 crashed -> P1 wins
000C79r 2  85 61          sta ROUND_RESULT
000C7Br 2  A9 03          lda #STATE_GAMEOVER
000C7Dr 2  85 3A          sta GAME_STATE
000C7Fr 2  20 30 A0       jsr Beep
000C82r 2  20 rr rr       jsr DrawGameOverScreen
000C85r 2  60             rts
000C86r 2               
000C86r 2               ResolveBothDead:
000C86r 2  A9 03          lda #3
000C88r 2  85 61          sta ROUND_RESULT
000C8Ar 2  A9 03          lda #STATE_GAMEOVER
000C8Cr 2  85 3A          sta GAME_STATE
000C8Er 2  20 30 A0       jsr Beep
000C91r 2  20 rr rr       jsr DrawGameOverScreen
000C94r 2               
000C94r 2               TickDone:
000C94r 2  60             rts
000C95r 2               
000C95r 2               StartRound:
000C95r 2  A9 00          lda #0
000C97r 2  20 0F A0       jsr SetIOMode
000C9Ar 2  20 rr rr       jsr InitGraphicsI
000C9Dr 2  20 rr rr       jsr ClearScreen
000CA0r 2  20 rr rr       jsr DrawBorder
000CA3r 2               
000CA3r 2  64 61          stz ROUND_RESULT
000CA5r 2               
000CA5r 2  A9 40          lda #64
000CA7r 2  85 40          sta P1_X
000CA9r 2  A9 60          lda #96
000CABr 2  85 41          sta P1_Y
000CADr 2  A9 03          lda #DIR_RIGHT
000CAFr 2  85 42          sta P1_DIR
000CB1r 2  85 43          sta P1_NEXT_DIR
000CB3r 2  A9 01          lda #$01
000CB5r 2  85 44          sta P1_ALIVE
000CB7r 2               
000CB7r 2  A9 BF          lda #191
000CB9r 2  85 45          sta P2_X
000CBBr 2  A9 60          lda #96
000CBDr 2  85 46          sta P2_Y
000CBFr 2  A9 02          lda #DIR_LEFT
000CC1r 2  85 47          sta P2_DIR
000CC3r 2  85 48          sta P2_NEXT_DIR
000CC5r 2  A9 01          lda #$01
000CC7r 2  85 49          sta P2_ALIVE
000CC9r 2               
000CC9r 2  A5 41          lda P1_Y
000CCBr 2  A6 40          ldx P1_X
000CCDr 2  20 rr rr       jsr PixelSetP1Trail
000CD0r 2               
000CD0r 2  A5 46          lda P2_Y
000CD2r 2  A6 45          ldx P2_X
000CD4r 2  20 rr rr       jsr PixelSetP2Trail
000CD7r 2               
000CD7r 2  A9 01          lda #STATE_PLAYING
000CD9r 2  85 3A          sta GAME_STATE
000CDBr 2  20 rr rr       jsr UpdateHeadSprites
000CDEr 2  60             rts
000CDFr 2               
000CDFr 2               ; -----------------------------------------------------------------------------
000CDFr 2               ; DrawTitleScreen — always a full wipe and fresh redraw in the same bitmap
000CDFr 2               ; mode gameplay uses (never a mode switch into the Kernal's separate text
000CDFr 2               ; console), since that mode-switch round trip is exactly what made the old
000CDFr 2               ; text-mode title/win screens unreliable: InitVideo resets the color scheme
000CDFr 2               ; out from under whatever was on screen, and VideoClear did not reliably
000CDFr 2               ; clear content reached from bitmap mode. Reached both at initial boot
000CDFr 2               ; (over an already-blank bitmap) and after a game over (over the live,
000CDFr 2               ; frozen final trail state under the win overlay) -- wiping only at one of
000CDFr 2               ; those call sites would leave the other showing stale content underneath.
000CDFr 2               ; -----------------------------------------------------------------------------
000CDFr 2               DrawTitleScreen:
000CDFr 2  20 rr rr       jsr ClearScreen
000CE2r 2  20 rr rr       jsr DrawBorder
000CE5r 2               
000CE5r 2                 ; Hide both head sprites -- ClearScreen only wipes the bitmap/color
000CE5r 2                 ; planes, not the separate hardware sprite layer. A round that ends in
000CE5r 2                 ; a crash never gets to UpdateHeadSprites's "both alive" branch (see
000CE5r 2                 ; ResolveRound), so a dead player's sprite is left frozen at its last
000CE5r 2                 ; position instead of being hidden, and stays visible straight through
000CE5r 2                 ; the game-over screen and onto this title screen too, since nothing
000CE5r 2                 ; else ever touches the sprite attribute table on this path.
000CE5r 2  20 rr rr       jsr InitHeadSprites
000CE8r 2               
000CE8r 2  A9 3A          lda #58
000CEAr 2  85 6F          sta TEXT_ROW
000CECr 2  A9 38          lda #56
000CEEr 2  85 70          sta TEXT_COL
000CF0r 2  A9 0F          lda #TMS_WHITE
000CF2r 2  85 71          sta TEXT_COLOR
000CF4r 2  A9 rr          lda #<TitleLine1
000CF6r 2  85 78          sta TEXT_STR_PTR
000CF8r 2  A9 rr          lda #>TitleLine1
000CFAr 2  85 79          sta TEXT_STR_PTR+1
000CFCr 2  20 rr rr       jsr DrawTextBig
000CFFr 2               
000CFFr 2  20 rr rr       jsr DrawTitleDecoration
000D02r 2               
000D02r 2                 ; Static labels that never change while the title screen is up, drawn
000D02r 2                 ; once here rather than every tick from DrawModeLine/DrawColorLines --
000D02r 2                 ; those two only need to erase-and-redraw the parts that actually
000D02r 2                 ; change (the 1P/2P suffix, the two color swatches). MODE and the color
000D02r 2                 ; pickers come before "A START" -- you set these up, then confirm.
000D02r 2  A9 58          lda #88
000D04r 2  85 6F          sta TEXT_ROW
000D06r 2  A9 68          lda #104
000D08r 2  85 70          sta TEXT_COL
000D0Ar 2  A9 0F          lda #TMS_WHITE
000D0Cr 2  85 71          sta TEXT_COLOR
000D0Er 2  A9 rr          lda #<ModeLabel
000D10r 2  85 78          sta TEXT_STR_PTR
000D12r 2  A9 rr          lda #>ModeLabel
000D14r 2  85 79          sta TEXT_STR_PTR+1
000D16r 2  20 rr rr       jsr DrawText
000D19r 2               
000D19r 2                 ; Up/down triangles flanking the MODE value -- unlike the color
000D19r 2                 ; swatches' left/right chevrons, MODE is an up/down control, so it gets
000D19r 2                 ; a shape that actually points the right way instead of reusing </>
000D19r 2                 ; sideways (which wouldn't read as "up/down" to anyone looking at it).
000D19r 2                 ; The value string is " 1P"/" 2P" (a blank leading cell, then the
000D19r 2                 ; digit, then P) starting at TEXT_COL 136 (see DrawModeLine for why not
000D19r 2                 ; 134), so the actual ink -- the digit+P pair -- spans pixel columns
000D19r 2                 ; 142-152, centered on 147; the triangle is 5px wide, so its left edge
000D19r 2                 ; belongs at 147-2=145, not centered over just the leading digit's cell.
000D19r 2  A9 53          lda #83
000D1Br 2  A2 91          ldx #145
000D1Dr 2  A0 0F          ldy #TMS_WHITE
000D1Fr 2  20 rr rr       jsr DrawUpTriangle
000D22r 2  A9 61          lda #97
000D24r 2  A2 91          ldx #145
000D26r 2  A0 0F          ldy #TMS_WHITE
000D28r 2  20 rr rr       jsr DrawDownTriangle
000D2Br 2               
000D2Br 2  A9 69          lda #105
000D2Dr 2  85 6F          sta TEXT_ROW
000D2Fr 2  A9 6B          lda #107
000D31r 2  85 70          sta TEXT_COL
000D33r 2  A9 0F          lda #TMS_WHITE
000D35r 2  85 71          sta TEXT_COLOR
000D37r 2  A9 rr          lda #<P1ColorLabel
000D39r 2  85 78          sta TEXT_STR_PTR
000D3Br 2  A9 rr          lda #>P1ColorLabel
000D3Dr 2  85 79          sta TEXT_STR_PTR+1
000D3Fr 2  20 rr rr       jsr DrawText
000D42r 2               
000D42r 2                 ; Left/right triangles flanking the swatch -- custom shapes matching
000D42r 2                 ; the up/down triangles' style, rather than the font's thin </> glyphs.
000D42r 2                 ; The swatch is 7px (matching the font's glyph height) starting at the
000D42r 2                 ; same row as the "P1:" label text (105), so with the triangle at 5px
000D42r 2                 ; both are odd-sized and +1 row down from the swatch's top lands the
000D42r 2                 ; triangle exactly centered on it -- no more rounding compromise.
000D42r 2                 ; Columns stay 2px clear of the swatch on each side (left triangle's
000D42r 2                 ; right edge at 133, right triangle's left edge at 145) so the swatch
000D42r 2                 ; reads as centered between them.
000D42r 2  A9 6A          lda #106
000D44r 2  A2 83          ldx #131
000D46r 2  A0 0F          ldy #TMS_WHITE
000D48r 2  20 rr rr       jsr DrawLeftTriangle
000D4Br 2  A9 6A          lda #106
000D4Dr 2  A2 91          ldx #145
000D4Fr 2  A0 0F          ldy #TMS_WHITE
000D51r 2  20 rr rr       jsr DrawRightTriangle
000D54r 2               
000D54r 2  A9 74          lda #116
000D56r 2  85 6F          sta TEXT_ROW
000D58r 2  A9 6B          lda #107
000D5Ar 2  85 70          sta TEXT_COL
000D5Cr 2  A9 0F          lda #TMS_WHITE
000D5Er 2  85 71          sta TEXT_COLOR
000D60r 2  A9 rr          lda #<P2ColorLabel
000D62r 2  85 78          sta TEXT_STR_PTR
000D64r 2  A9 rr          lda #>P2ColorLabel
000D66r 2  85 79          sta TEXT_STR_PTR+1
000D68r 2  20 rr rr       jsr DrawText
000D6Br 2               
000D6Br 2  A9 75          lda #117
000D6Dr 2  A2 83          ldx #131
000D6Fr 2  A0 0F          ldy #TMS_WHITE
000D71r 2  20 rr rr       jsr DrawLeftTriangle
000D74r 2  A9 75          lda #117
000D76r 2  A2 91          ldx #145
000D78r 2  A0 0F          ldy #TMS_WHITE
000D7Ar 2  20 rr rr       jsr DrawRightTriangle
000D7Dr 2               
000D7Dr 2  A9 85          lda #133
000D7Fr 2  85 6F          sta TEXT_ROW
000D81r 2  A9 6B          lda #107
000D83r 2  85 70          sta TEXT_COL
000D85r 2  A9 0F          lda #TMS_WHITE
000D87r 2  85 71          sta TEXT_COLOR
000D89r 2  A9 rr          lda #<TitleLine4
000D8Br 2  85 78          sta TEXT_STR_PTR
000D8Dr 2  A9 rr          lda #>TitleLine4
000D8Fr 2  85 79          sta TEXT_STR_PTR+1
000D91r 2  20 rr rr       jsr DrawText
000D94r 2               
000D94r 2                 ; Force the first DrawModeLine/DrawColorLines call below to actually
000D94r 2                 ; draw, regardless of whether GAME_MODE/the color indices happen to
000D94r 2                 ; match whatever they were the last time the title screen was up.
000D94r 2  A9 FF          lda #$FF
000D96r 2  85 7B          sta LAST_GAME_MODE
000D98r 2  85 7C          sta LAST_P1_COLOR_IDX
000D9Ar 2  85 7D          sta LAST_P2_COLOR_IDX
000D9Cr 2               
000D9Cr 2  20 rr rr       jsr DrawModeLine
000D9Fr 2  20 rr rr       jsr DrawColorLines
000DA2r 2               
000DA2r 2  A9 00          lda #STATE_TITLE
000DA4r 2  85 3A          sta GAME_STATE
000DA6r 2  60             rts
000DA7r 2               
000DA7r 2               ; -----------------------------------------------------------------------------
000DA7r 2               ; DrawTitleDecoration — the title underlined in each player's trail color:
000DA7r 2               ; "LIGHT" in P1's, "CYCLES" in P2's, so the title screen reads as the same
000DA7r 2               ; game rather than a bolted-on splash, right from the two-word split the
000DA7r 2               ; name already has. Split into DrawP1Underline/DrawP2Underline (rather than
000DA7r 2               ; one inline pass) so DrawColorLines can also call just one of them to
000DA7r 2               ; live-update a line the instant that player's color changes, reusing its
000DA7r 2               ; existing per-player change-tracking instead of a separate copy of it here.
000DA7r 2               ; -----------------------------------------------------------------------------
000DA7r 2               DrawTitleDecoration:
000DA7r 2  20 rr rr       jsr DrawP1Underline
000DAAr 2  4C rr rr       jmp DrawP2Underline
000DADr 2               
000DADr 2               ; -----------------------------------------------------------------------------
000DADr 2               ; DrawP1Underline — erases and redraws the underline beneath "LIGHT" (row
000DADr 2               ; 74) in P1's trail color, with a single white lead pixel at its rightmost
000DADr 2               ; end, closest to P2's line, so the two read as racing toward each other
000DADr 2               ; across the gap between the words. White outright, not a brighter tint of
000DADr 2               ; the trail color -- a picked color's "bright" tier (used by the head
000DADr 2               ; sprites) is sometimes identical to its own trail color (light blue/light
000DADr 2               ; yellow have no brighter tier above them), which made the lead invisible
000DADr 2               ; for those picks.
000DADr 2               ; It's one real pixel, not a wider block -- the TMS9918's Graphics II color
000DADr 2               ; table is one color per 8 horizontal pixels per scanline (the same
000DADr 2               ; granularity that caused the MODE colon to render invisible earlier), so a
000DADr 2               ; pixel can only carry a color different from its neighbors' if it's the
000DADr 2               ; only thing touched in its 8-pixel-aligned byte. Column 112 is the first
000DADr 2               ; pixel of such a byte, right after the body's last byte-aligned column
000DADr 2               ; (111), so the body shrinks 1px (to end at 111 instead of 113) to land
000DADr 2               ; exactly there -- no gap, no color collision.
000DADr 2               ; Must erase first, not just redraw over the old pixels -- PixelSet only
000DADr 2               ; ever turns bits on, and a color byte already claimed by the old color
000DADr 2               ; won't take a new one without an explicit clear first.
000DADr 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, TEXT_COLOR, TEXT_ROW_I, TEXT_COL_I,
000DADr 2               ;   plus everything PixelSet/PixelClear clobber
000DADr 2               ; -----------------------------------------------------------------------------
000DADr 2               DrawP1Underline:
000DADr 2  A9 01          lda #1
000DAFr 2  85 75          sta TEXT_ROW_I
000DB1r 2  A9 39          lda #57
000DB3r 2  85 76          sta TEXT_COL_I
000DB5r 2  A9 4A          lda #74
000DB7r 2  A2 38          ldx #56
000DB9r 2  20 rr rr       jsr EraseRect
000DBCr 2               
000DBCr 2  A4 64          ldy P1_TRAIL_COLOR
000DBEr 2  84 71          sty TEXT_COLOR
000DC0r 2  64 76          stz TEXT_COL_I
000DC2r 2               @bodyLoop:
000DC2r 2  A5 76          lda TEXT_COL_I
000DC4r 2  18             clc
000DC5r 2  69 38          adc #56
000DC7r 2  AA             tax
000DC8r 2  A9 4A          lda #74
000DCAr 2  A4 71          ldy TEXT_COLOR
000DCCr 2  20 rr rr       jsr PixelSet
000DCFr 2  E6 76          inc TEXT_COL_I
000DD1r 2  A5 76          lda TEXT_COL_I
000DD3r 2  C9 38          cmp #56                     ; body is cols 56-111 (56px, an exact run of
000DD5r 2  D0 EB          bne @bodyLoop                ; 7 color bytes); the lead pixel is at 112
000DD7r 2               
000DD7r 2  A9 4A          lda #74
000DD9r 2  A2 70          ldx #112
000DDBr 2  A0 0F          ldy #TMS_WHITE
000DDDr 2  20 rr rr       jsr PixelSet
000DE0r 2  60             rts
000DE1r 2               
000DE1r 2               ; -----------------------------------------------------------------------------
000DE1r 2               ; DrawP2Underline — same idea as DrawP1Underline, for the line beneath
000DE1r 2               ; "CYCLES" (row 74) in P2's trail color. Its white lead pixel is at the
000DE1r 2               ; LEFTMOST end instead -- P2's line faces P1's across the gap, so the lead
000DE1r 2               ; has to point the other way for the two to race toward each other rather
000DE1r 2               ; than both pointing right.
000DE1r 2               ; Column 128, the body's natural left edge, is ALREADY the first pixel of
000DE1r 2               ; an 8-pixel-aligned color byte -- there's no room to its left within that
000DE1r 2               ; byte for an isolated lead pixel without colliding with the body that
000DE1r 2               ; starts right there. So the lead goes 1px further left, at column 127 (the
000DE1r 2               ; last pixel of the PRECEDING byte, otherwise untouched -- that's clear
000DE1r 2               ; space in the gap between the words), and the body keeps its full original
000DE1r 2               ; width unchanged at 128-197. See DrawP1Underline for why the split has to
000DE1r 2               ; land on a byte boundary at all.
000DE1r 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, TEXT_COLOR, TEXT_ROW_I, TEXT_COL_I,
000DE1r 2               ;   plus everything PixelSet/PixelClear clobber
000DE1r 2               ; -----------------------------------------------------------------------------
000DE1r 2               DrawP2Underline:
000DE1r 2  A9 01          lda #1
000DE3r 2  85 75          sta TEXT_ROW_I
000DE5r 2  A9 47          lda #71
000DE7r 2  85 76          sta TEXT_COL_I
000DE9r 2  A9 4A          lda #74
000DEBr 2  A2 7F          ldx #127
000DEDr 2  20 rr rr       jsr EraseRect
000DF0r 2               
000DF0r 2  A9 4A          lda #74
000DF2r 2  A2 7F          ldx #127
000DF4r 2  A0 0F          ldy #TMS_WHITE
000DF6r 2  20 rr rr       jsr PixelSet
000DF9r 2               
000DF9r 2  A4 65          ldy P2_TRAIL_COLOR
000DFBr 2  84 71          sty TEXT_COLOR
000DFDr 2  A9 01          lda #1
000DFFr 2  85 76          sta TEXT_COL_I
000E01r 2               @bodyLoop:
000E01r 2  A5 76          lda TEXT_COL_I
000E03r 2  18             clc
000E04r 2  69 7F          adc #127
000E06r 2  AA             tax
000E07r 2  A9 4A          lda #74
000E09r 2  A4 71          ldy TEXT_COLOR
000E0Br 2  20 rr rr       jsr PixelSet
000E0Er 2  E6 76          inc TEXT_COL_I
000E10r 2  A5 76          lda TEXT_COL_I
000E12r 2  C9 47          cmp #71
000E14r 2  D0 EB          bne @bodyLoop
000E16r 2  60             rts
000E17r 2               
000E17r 2               ; -----------------------------------------------------------------------------
000E17r 2               ; DrawGameOverScreen — per Jay: the win screen IS the gameplay screen, with
000E17r 2               ; the result text drawn directly on top of the frozen final trail
000E17r 2               ; positions. No mode switch, no full clear -- draws straight into whatever
000E17r 2               ; is already on the bitmap plane. A (or space) returns to the title
000E17r 2               ; screen, where DrawTitleScreen's own full wipe takes over.
000E17r 2               ; Erases a margin around its own text first, though (unlike the rest of
000E17r 2               ; the frozen field, which is deliberately left alone) -- the result text
000E17r 2               ; can land anywhere the round happened to end, right up against a trail,
000E17r 2               ; so it has no way to guarantee landing clear of some trail pixel's
000E17r 2               ; already-claimed 8-pixel-wide color byte the way the title screen's
000E17r 2               ; fixed-position UI can. Without erasing first, any text pixel unlucky
000E17r 2               ; enough to share a color byte with a nearby trail pixel would silently
000E17r 2               ; render in the trail's color instead of white. The erase box is padded
000E17r 2               ; well past the glyphs themselves (not just their tight bounding box) so
000E17r 2               ; the text reads as sitting in its own clear space instead of packed
000E17r 2               ; right up against whatever trail happened to end nearby.
000E17r 2               ; Vertically centered on the 192px-tall field (row 93, so the 7px-tall
000E17r 2               ; glyphs sit on rows 93-99, centered on row 96) rather than a fixed row
000E17r 2               ; that happened to work for one particular round's trail shapes.
000E17r 2               ; Hides both head sprites first -- the frozen bitmap trail is deliberate,
000E17r 2               ; but the crash never reaches UpdateHeadSprites's "both alive" branch
000E17r 2               ; (see ResolveRound), so without this a dead player's sprite is left
000E17r 2               ; showing at its last pre-crash position instead of hidden, floating
000E17r 2               ; uselessly next to the actual crash site drawn into the bitmap.
000E17r 2               ; -----------------------------------------------------------------------------
000E17r 2               DrawGameOverScreen:
000E17r 2  20 rr rr       jsr InitHeadSprites
000E1Ar 2               
000E1Ar 2  A5 61          lda ROUND_RESULT
000E1Cr 2  C9 01          cmp #1
000E1Er 2  D0 07          bne @checkP2
000E20r 2  A9 rr          lda #<WinnerP1
000E22r 2  A0 rr          ldy #>WinnerP1
000E24r 2  4C rr rr       jmp @haveWinner
000E27r 2               @checkP2:
000E27r 2  A5 61          lda ROUND_RESULT
000E29r 2  C9 02          cmp #2
000E2Br 2  D0 07          bne @drawMsg
000E2Dr 2  A9 rr          lda #<WinnerP2
000E2Fr 2  A0 rr          ldy #>WinnerP2
000E31r 2  4C rr rr       jmp @haveWinner
000E34r 2               @drawMsg:
000E34r 2  A9 rr          lda #<WinnerDraw
000E36r 2  A0 rr          ldy #>WinnerDraw
000E38r 2               @haveWinner:
000E38r 2  85 78          sta TEXT_STR_PTR
000E3Ar 2  84 79          sty TEXT_STR_PTR+1
000E3Cr 2               
000E3Cr 2  A9 13          lda #19                   ; 7px glyph height + 6px margin top/bottom
000E3Er 2  85 75          sta TEXT_ROW_I
000E40r 2  A9 62          lda #98                   ; 78px longest string ("PLAYER 1/2 WINS", 13
000E42r 2  85 76          sta TEXT_COL_I              ; chars x 6px) + 10px margin each side
000E44r 2  A9 57          lda #87
000E46r 2  A2 4F          ldx #79
000E48r 2  20 rr rr       jsr EraseRect
000E4Br 2               
000E4Br 2  A9 5D          lda #93
000E4Dr 2  85 6F          sta TEXT_ROW
000E4Fr 2  A9 59          lda #89
000E51r 2  85 70          sta TEXT_COL
000E53r 2  A9 0F          lda #TMS_WHITE
000E55r 2  85 71          sta TEXT_COLOR
000E57r 2  20 rr rr       jsr DrawText
000E5Ar 2  60             rts
000E5Br 2               
000E5Br 2               ; -----------------------------------------------------------------------------
000E5Br 2               ; DrawModeLine — redraws only the "1P"/"2P" suffix after the static "MODE:"
000E5Br 2               ; label DrawTitleScreen already drew once. Erases just those 2 characters
000E5Br 2               ; (12x7 pixels) before redrawing, not the whole line -- PixelSet only ever
000E5Br 2               ; turns pixels on, so redrawing "2P" over "1P" without erasing first would
000E5Br 2               ; just overlay the new glyph's pixels on the old one instead of replacing
000E5Br 2               ; it, leaving a garbled blob that never looks like it updated.
000E5Br 2               ;
000E5Br 2               ; The value starts at column 136, not immediately after the label at 134 --
000E5Br 2               ; the TMS9918 color table is one byte per 8 horizontal pixels, and "MODE:"'s
000E5Br 2               ; colon lives in the pixel-128-135 byte. EraseRect's PixelClear resets a
000E5Br 2               ; pixel's whole 8-wide color byte back to "unclaimed" unconditionally, so
000E5Br 2               ; erasing anything in columns 134-135 would silently blow away the colon's
000E5Br 2               ; already-claimed white color the moment this first runs, leaving it
000E5Br 2               ; rendering black-on-black despite its bitmap bits being untouched. Starting
000E5Br 2               ; the erase/redraw at column 136 keeps it in the next color byte entirely.
000E5Br 2               ; -----------------------------------------------------------------------------
000E5Br 2               DrawModeLine:
000E5Br 2  A5 3B          lda GAME_MODE
000E5Dr 2  C5 7B          cmp LAST_GAME_MODE
000E5Fr 2  F0 39          beq @unchanged
000E61r 2  85 7B          sta LAST_GAME_MODE
000E63r 2               
000E63r 2  A9 07          lda #7
000E65r 2  85 75          sta TEXT_ROW_I
000E67r 2  A9 0C          lda #12
000E69r 2  85 76          sta TEXT_COL_I
000E6Br 2  A9 58          lda #88
000E6Dr 2  A2 88          ldx #136
000E6Fr 2  20 rr rr       jsr EraseRect
000E72r 2               
000E72r 2  A9 58          lda #88
000E74r 2  85 6F          sta TEXT_ROW
000E76r 2  A9 88          lda #136
000E78r 2  85 70          sta TEXT_COL
000E7Ar 2  A9 0F          lda #TMS_WHITE
000E7Cr 2  85 71          sta TEXT_COLOR
000E7Er 2               
000E7Er 2  A5 3B          lda GAME_MODE
000E80r 2  C9 00          cmp #MODE_1P
000E82r 2  D0 0B          bne @mode2
000E84r 2  A9 rr          lda #<ModeSuffix1P
000E86r 2  85 78          sta TEXT_STR_PTR
000E88r 2  A9 rr          lda #>ModeSuffix1P
000E8Ar 2  85 79          sta TEXT_STR_PTR+1
000E8Cr 2  4C rr rr       jmp DrawText
000E8Fr 2               @mode2:
000E8Fr 2  A9 rr          lda #<ModeSuffix2P
000E91r 2  85 78          sta TEXT_STR_PTR
000E93r 2  A9 rr          lda #>ModeSuffix2P
000E95r 2  85 79          sta TEXT_STR_PTR+1
000E97r 2  4C rr rr       jmp DrawText
000E9Ar 2               @unchanged:
000E9Ar 2  60             rts
000E9Br 2               
000E9Br 2               ; -----------------------------------------------------------------------------
000E9Br 2               ; DrawColorLines — redraws only the two color swatches (the "P1/P2 COLOR:"
000E9Br 2               ; labels are static, drawn once by DrawTitleScreen), and the matching title
000E9Br 2               ; underline (DrawP1Underline/DrawP2Underline), so the underline color tracks
000E9Br 2               ; the picker live instead of only reflecting whatever it was when the title
000E9Br 2               ; screen was first entered. See DrawModeLine for why the swatch needs
000E9Br 2               ; erasing before it's redrawn in a new color.
000E9Br 2               ; -----------------------------------------------------------------------------
000E9Br 2               DrawColorLines:
000E9Br 2  A5 62          lda P1_COLOR_IDX
000E9Dr 2  C5 7C          cmp LAST_P1_COLOR_IDX
000E9Fr 2  F0 21          beq @p1Unchanged
000EA1r 2  85 7C          sta LAST_P1_COLOR_IDX
000EA3r 2               
000EA3r 2  A9 07          lda #7                    ; erase the old swatch first -- see
000EA5r 2  85 75          sta TEXT_ROW_I              ; DrawModeLine for why
000EA7r 2  A9 07          lda #7
000EA9r 2  85 76          sta TEXT_COL_I
000EABr 2  A9 69          lda #105
000EADr 2  A2 88          ldx #136
000EAFr 2  20 rr rr       jsr EraseRect
000EB2r 2               
000EB2r 2  A6 62          ldx P1_COLOR_IDX
000EB4r 2  BD rr rr       lda TrailFgColorTable,x
000EB7r 2  A8             tay
000EB8r 2  A9 69          lda #105
000EBAr 2  A2 88          ldx #136
000EBCr 2  20 rr rr       jsr DrawColorSwatch
000EBFr 2  20 rr rr       jsr DrawP1Underline
000EC2r 2               @p1Unchanged:
000EC2r 2               
000EC2r 2  A5 63          lda P2_COLOR_IDX
000EC4r 2  C5 7D          cmp LAST_P2_COLOR_IDX
000EC6r 2  F0 21          beq @p2Unchanged
000EC8r 2  85 7D          sta LAST_P2_COLOR_IDX
000ECAr 2               
000ECAr 2  A9 07          lda #7                    ; erase the old swatch first -- see
000ECCr 2  85 75          sta TEXT_ROW_I              ; DrawModeLine for why
000ECEr 2  A9 07          lda #7
000ED0r 2  85 76          sta TEXT_COL_I
000ED2r 2  A9 74          lda #116
000ED4r 2  A2 88          ldx #136
000ED6r 2  20 rr rr       jsr EraseRect
000ED9r 2               
000ED9r 2  A6 63          ldx P2_COLOR_IDX
000EDBr 2  BD rr rr       lda TrailFgColorTable,x
000EDEr 2  A8             tay
000EDFr 2  A9 74          lda #116
000EE1r 2  A2 88          ldx #136
000EE3r 2  20 rr rr       jsr DrawColorSwatch
000EE6r 2  20 rr rr       jsr DrawP2Underline
000EE9r 2               @p2Unchanged:
000EE9r 2  60             rts
000EEAr 2               
000EEAr 2               ; -----------------------------------------------------------------------------
000EEAr 2               ; HandleColorPicker — lets each player cycle their own trail color with
000EEAr 2               ; LEFT/RIGHT on their own joystick, or A/D (P1) / arrow LEFT-RIGHT (P2) on
000EEAr 2               ; the keyboard as a fallback. Reuses JOY_STATE/JOY_STATE2 and KB_DIR_P1/
000EEAr 2               ; KB_DIR_P2 already populated this tick by PollInput/PollInputP2 (see
000EEAr 2               ; LightCycles.asm's MainLoop) instead of re-reading hardware or re-draining
000EEAr 2               ; the keyboard — Chrin's buffer is already empty by the time this runs.
000EEAr 2               ; Joystick-first per player: if that player's joystick shows LEFT or RIGHT
000EEAr 2               ; this poll, the keyboard is not consulted this poll. MENU_P1_PREV/
000EEAr 2               ; MENU_P2_PREV debounce on release exactly as before, now covering both
000EEAr 2               ; input sources — holding either (or switching between them without a
000EEAr 2               ; release in between) will not repeatedly re-trigger a color change.
000EEAr 2               ; -----------------------------------------------------------------------------
000EEAr 2               HandleColorPicker:
000EEAr 2                 ; P1: synthesize an effective LEFT/RIGHT byte — joystick 1 as read this
000EEAr 2                 ; tick by PollInput's PollJoy1 call, or (only if idle on both bits) this
000EEAr 2                 ; tick's WASD result (KB_DIR_P1) from PollInput's DrainKeyboardSplit call.
000EEAr 2  A5 3E          lda JOY_STATE
000EECr 2  29 C0          and #(JOY_LEFT | JOY_RIGHT)
000EEEr 2  85 6B          sta PICKER_TMP
000EF0r 2  C9 C0          cmp #(JOY_LEFT | JOY_RIGHT)
000EF2r 2  D0 12          bne @p1Have
000EF4r 2  A9 C0          lda #(JOY_LEFT | JOY_RIGHT)
000EF6r 2  A6 68          ldx KB_DIR_P1
000EF8r 2  E0 02          cpx #DIR_LEFT
000EFAr 2  D0 02          bne @p1NotKbLeft
000EFCr 2  29 80          and #JOY_RIGHT
000EFEr 2               @p1NotKbLeft:
000EFEr 2  E0 03          cpx #DIR_RIGHT
000F00r 2  D0 02          bne @p1NotKbRight
000F02r 2  29 40          and #JOY_LEFT
000F04r 2               @p1NotKbRight:
000F04r 2  85 6B          sta PICKER_TMP
000F06r 2               @p1Have:
000F06r 2  A5 6B          lda PICKER_TMP
000F08r 2  29 40          and #JOY_LEFT
000F0Ar 2  D0 07          bne @p1NoLeft
000F0Cr 2  A5 66          lda MENU_P1_PREV
000F0Er 2  D0 03          bne @p1NoLeft
000F10r 2  20 rr rr       jsr DecP1Color
000F13r 2               @p1NoLeft:
000F13r 2  A5 6B          lda PICKER_TMP
000F15r 2  29 80          and #JOY_RIGHT
000F17r 2  D0 07          bne @p1NoRight
000F19r 2  A5 66          lda MENU_P1_PREV
000F1Br 2  D0 03          bne @p1NoRight
000F1Dr 2  20 rr rr       jsr IncP1Color
000F20r 2               @p1NoRight:
000F20r 2  A5 6B          lda PICKER_TMP
000F22r 2  29 C0          and #(JOY_LEFT | JOY_RIGHT)
000F24r 2  C9 C0          cmp #(JOY_LEFT | JOY_RIGHT)
000F26r 2  F0 07          beq @p1Release
000F28r 2  A9 01          lda #1
000F2Ar 2  85 66          sta MENU_P1_PREV
000F2Cr 2  4C rr rr       jmp @p2
000F2Fr 2               @p1Release:
000F2Fr 2  64 66          stz MENU_P1_PREV
000F31r 2               
000F31r 2               @p2:
000F31r 2                 ; P2: same synthesis, using JOY_STATE2 (PollInputP2's PollJoy2 this
000F31r 2                 ; tick) and KB_DIR_P2 (arrow keys, same DrainKeyboardSplit call).
000F31r 2  A5 4F          lda JOY_STATE2
000F33r 2  29 C0          and #(JOY_LEFT | JOY_RIGHT)
000F35r 2  85 6B          sta PICKER_TMP
000F37r 2  C9 C0          cmp #(JOY_LEFT | JOY_RIGHT)
000F39r 2  D0 12          bne @p2Have
000F3Br 2  A9 C0          lda #(JOY_LEFT | JOY_RIGHT)
000F3Dr 2  A6 69          ldx KB_DIR_P2
000F3Fr 2  E0 02          cpx #DIR_LEFT
000F41r 2  D0 02          bne @p2NotKbLeft
000F43r 2  29 80          and #JOY_RIGHT
000F45r 2               @p2NotKbLeft:
000F45r 2  E0 03          cpx #DIR_RIGHT
000F47r 2  D0 02          bne @p2NotKbRight
000F49r 2  29 40          and #JOY_LEFT
000F4Br 2               @p2NotKbRight:
000F4Br 2  85 6B          sta PICKER_TMP
000F4Dr 2               @p2Have:
000F4Dr 2  A5 6B          lda PICKER_TMP
000F4Fr 2  29 40          and #JOY_LEFT
000F51r 2  D0 07          bne @p2NoLeft
000F53r 2  A5 67          lda MENU_P2_PREV
000F55r 2  D0 03          bne @p2NoLeft
000F57r 2  20 rr rr       jsr DecP2Color
000F5Ar 2               @p2NoLeft:
000F5Ar 2  A5 6B          lda PICKER_TMP
000F5Cr 2  29 80          and #JOY_RIGHT
000F5Er 2  D0 07          bne @p2NoRight
000F60r 2  A5 67          lda MENU_P2_PREV
000F62r 2  D0 03          bne @p2NoRight
000F64r 2  20 rr rr       jsr IncP2Color
000F67r 2               @p2NoRight:
000F67r 2  A5 6B          lda PICKER_TMP
000F69r 2  29 C0          and #(JOY_LEFT | JOY_RIGHT)
000F6Br 2  C9 C0          cmp #(JOY_LEFT | JOY_RIGHT)
000F6Dr 2  F0 05          beq @p2Release
000F6Fr 2  A9 01          lda #1
000F71r 2  85 67          sta MENU_P2_PREV
000F73r 2  60             rts
000F74r 2               @p2Release:
000F74r 2  64 67          stz MENU_P2_PREV
000F76r 2  60             rts
000F77r 2               
000F77r 2               ; -----------------------------------------------------------------------------
000F77r 2               ; IncP1Color/DecP1Color/IncP2Color/DecP2Color — cycle a player's trail
000F77r 2               ; color index, skipping past whatever the OTHER player currently has
000F77r 2               ; selected. Same-colored trails are only distinguishable by the head
000F77r 2               ; sprites (both flat white, independent of trail color), not by the
000F77r 2               ; trail itself, so letting both players land on the same color is a real
000F77r 2               ; way to confuse yourself for no benefit -- worth blocking outright rather
000F77r 2               ; than leaving it as a footgun, since 6 of 7 colors are still available
000F77r 2               ; either way. Only ever skips one extra step: landing on a clash after a
000F77r 2               ; single +1/-1 move can only happen once before moving away from it.
000F77r 2               ; -----------------------------------------------------------------------------
000F77r 2               IncP1Color:
000F77r 2  A5 62          lda P1_COLOR_IDX
000F79r 2  C9 06          cmp #6
000F7Br 2  D0 04          bne @p1Inc
000F7Dr 2  64 62          stz P1_COLOR_IDX
000F7Fr 2  80 02          bra @p1Clash
000F81r 2               @p1Inc:
000F81r 2  E6 62          inc P1_COLOR_IDX
000F83r 2               @p1Clash:
000F83r 2  A5 62          lda P1_COLOR_IDX
000F85r 2  C5 63          cmp P2_COLOR_IDX
000F87r 2  D0 0D          bne @p1Done
000F89r 2  A5 62          lda P1_COLOR_IDX
000F8Br 2  C9 06          cmp #6
000F8Dr 2  D0 05          bne @p1Inc2
000F8Fr 2  64 62          stz P1_COLOR_IDX
000F91r 2  4C rr rr       jmp ApplySelectedTrailColors
000F94r 2               @p1Inc2:
000F94r 2  E6 62          inc P1_COLOR_IDX
000F96r 2               @p1Done:
000F96r 2  4C rr rr       jmp ApplySelectedTrailColors
000F99r 2               
000F99r 2               DecP1Color:
000F99r 2  A5 62          lda P1_COLOR_IDX
000F9Br 2  D0 06          bne @p1Dec
000F9Dr 2  A9 06          lda #6
000F9Fr 2  85 62          sta P1_COLOR_IDX
000FA1r 2  80 02          bra @p1Clash
000FA3r 2               @p1Dec:
000FA3r 2  C6 62          dec P1_COLOR_IDX
000FA5r 2               @p1Clash:
000FA5r 2  A5 62          lda P1_COLOR_IDX
000FA7r 2  C5 63          cmp P2_COLOR_IDX
000FA9r 2  D0 0D          bne @p1Done
000FABr 2  A5 62          lda P1_COLOR_IDX
000FADr 2  D0 07          bne @p1Dec2
000FAFr 2  A9 06          lda #6
000FB1r 2  85 62          sta P1_COLOR_IDX
000FB3r 2  4C rr rr       jmp ApplySelectedTrailColors
000FB6r 2               @p1Dec2:
000FB6r 2  C6 62          dec P1_COLOR_IDX
000FB8r 2               @p1Done:
000FB8r 2  4C rr rr       jmp ApplySelectedTrailColors
000FBBr 2               
000FBBr 2               IncP2Color:
000FBBr 2  A5 63          lda P2_COLOR_IDX
000FBDr 2  C9 06          cmp #6
000FBFr 2  D0 04          bne @p2Inc
000FC1r 2  64 63          stz P2_COLOR_IDX
000FC3r 2  80 02          bra @p2Clash
000FC5r 2               @p2Inc:
000FC5r 2  E6 63          inc P2_COLOR_IDX
000FC7r 2               @p2Clash:
000FC7r 2  A5 63          lda P2_COLOR_IDX
000FC9r 2  C5 62          cmp P1_COLOR_IDX
000FCBr 2  D0 0D          bne @p2Done
000FCDr 2  A5 63          lda P2_COLOR_IDX
000FCFr 2  C9 06          cmp #6
000FD1r 2  D0 05          bne @p2Inc2
000FD3r 2  64 63          stz P2_COLOR_IDX
000FD5r 2  4C rr rr       jmp ApplySelectedTrailColors
000FD8r 2               @p2Inc2:
000FD8r 2  E6 63          inc P2_COLOR_IDX
000FDAr 2               @p2Done:
000FDAr 2  4C rr rr       jmp ApplySelectedTrailColors
000FDDr 2               
000FDDr 2               DecP2Color:
000FDDr 2  A5 63          lda P2_COLOR_IDX
000FDFr 2  D0 06          bne @p2Dec
000FE1r 2  A9 06          lda #6
000FE3r 2  85 63          sta P2_COLOR_IDX
000FE5r 2  80 02          bra @p2Clash
000FE7r 2               @p2Dec:
000FE7r 2  C6 63          dec P2_COLOR_IDX
000FE9r 2               @p2Clash:
000FE9r 2  A5 63          lda P2_COLOR_IDX
000FEBr 2  C5 62          cmp P1_COLOR_IDX
000FEDr 2  D0 0D          bne @p2Done
000FEFr 2  A5 63          lda P2_COLOR_IDX
000FF1r 2  D0 07          bne @p2Dec2
000FF3r 2  A9 06          lda #6
000FF5r 2  85 63          sta P2_COLOR_IDX
000FF7r 2  4C rr rr       jmp ApplySelectedTrailColors
000FFAr 2               @p2Dec2:
000FFAr 2  C6 63          dec P2_COLOR_IDX
000FFCr 2               @p2Done:
000FFCr 2  4C rr rr       jmp ApplySelectedTrailColors
000FFFr 2               
000FFFr 2               ApplySelectedTrailColors:
000FFFr 2  A6 62          ldx P1_COLOR_IDX
001001r 2  BD rr rr       lda TrailFgColorTable,x
001004r 2  85 64          sta P1_TRAIL_COLOR
001006r 2               
001006r 2  A6 63          ldx P2_COLOR_IDX
001008r 2  BD rr rr       lda TrailFgColorTable,x
00100Br 2  85 65          sta P2_TRAIL_COLOR
00100Dr 2  60             rts
00100Er 2               
00100Er 2               ; -----------------------------------------------------------------------------
00100Er 2               ; SetModeFromInput — up or down (either player) toggles GAME_MODE between
00100Er 2               ; 1P/2P, rather than a fixed up=1P/down=2P mapping. NEXT_DIR can't drive
00100Er 2               ; this: it's deliberately sticky for gameplay (a bike keeps its last
00100Er 2               ; heading even with no input), so it never goes back to "nothing pressed"
00100Er 2               ; and would toggle on every single tick a direction was last left facing
00100Er 2               ; up/down. Synthesizes an effective UP/DOWN byte per player exactly like
00100Er 2               ; HandleColorPicker's left/right synthesis (joystick first, WASD/arrow
00100Er 2               ; fallback only when that player's stick is idle), ANDs P1's and P2's
00100Er 2               ; bytes together so a press on either side counts, and MENU_MODE_PREV
00100Er 2               ; debounces it to one toggle per press-release cycle.
00100Er 2               ; -----------------------------------------------------------------------------
00100Er 2               SetModeFromInput:
00100Er 2  A5 3E          lda JOY_STATE
001010r 2  29 30          and #(JOY_UP | JOY_DOWN)
001012r 2  85 6B          sta PICKER_TMP
001014r 2  C9 30          cmp #(JOY_UP | JOY_DOWN)
001016r 2  D0 12          bne @p1Have
001018r 2  A9 30          lda #(JOY_UP | JOY_DOWN)
00101Ar 2  A6 68          ldx KB_DIR_P1
00101Cr 2  E0 00          cpx #DIR_UP
00101Er 2  D0 02          bne @p1NotKbUp
001020r 2  29 20          and #JOY_DOWN
001022r 2               @p1NotKbUp:
001022r 2  E0 01          cpx #DIR_DOWN
001024r 2  D0 02          bne @p1NotKbDown
001026r 2  29 10          and #JOY_UP
001028r 2               @p1NotKbDown:
001028r 2  85 6B          sta PICKER_TMP
00102Ar 2               @p1Have:
00102Ar 2               
00102Ar 2  A5 4F          lda JOY_STATE2
00102Cr 2  29 30          and #(JOY_UP | JOY_DOWN)
00102Er 2  85 77          sta SCAN_TMP2
001030r 2  C9 30          cmp #(JOY_UP | JOY_DOWN)
001032r 2  D0 12          bne @p2Have
001034r 2  A9 30          lda #(JOY_UP | JOY_DOWN)
001036r 2  A6 69          ldx KB_DIR_P2
001038r 2  E0 00          cpx #DIR_UP
00103Ar 2  D0 02          bne @p2NotKbUp
00103Cr 2  29 20          and #JOY_DOWN
00103Er 2               @p2NotKbUp:
00103Er 2  E0 01          cpx #DIR_DOWN
001040r 2  D0 02          bne @p2NotKbDown
001042r 2  29 10          and #JOY_UP
001044r 2               @p2NotKbDown:
001044r 2  85 77          sta SCAN_TMP2
001046r 2               @p2Have:
001046r 2               
001046r 2  A5 6B          lda PICKER_TMP
001048r 2  25 77          and SCAN_TMP2
00104Ar 2  C9 30          cmp #(JOY_UP | JOY_DOWN)
00104Cr 2  D0 03          bne @pressed
00104Er 2  64 80          stz MENU_MODE_PREV
001050r 2  60             rts
001051r 2               @pressed:
001051r 2  A5 80          lda MENU_MODE_PREV
001053r 2  D0 0A          bne @done
001055r 2  A9 01          lda #1
001057r 2  85 80          sta MENU_MODE_PREV
001059r 2  A5 3B          lda GAME_MODE
00105Br 2  49 01          eor #1
00105Dr 2  85 3B          sta GAME_MODE
00105Fr 2               @done:
00105Fr 2  60             rts
001060r 2               
001060r 2               TitleLine1:
001060r 2  4C 49 47 48    .byte "LIGHT CYCLES",0
001064r 2  54 20 43 59  
001068r 2  43 4C 45 53  
00106Dr 2               
00106Dr 2               TitleLine4:
00106Dr 2  41 3A 20 53    .byte "A: START",0
001071r 2  54 41 52 54  
001075r 2  00           
001076r 2               
001076r 2               WinnerP1:
001076r 2  50 4C 41 59    .byte "PLAYER 1 WINS",0
00107Ar 2  45 52 20 31  
00107Er 2  20 57 49 4E  
001084r 2               
001084r 2               WinnerP2:
001084r 2  50 4C 41 59    .byte "PLAYER 2 WINS",0
001088r 2  45 52 20 32  
00108Cr 2  20 57 49 4E  
001092r 2               
001092r 2               WinnerDraw:
001092r 2  44 4F 55 42    .byte "DOUBLE CRASH",0
001096r 2  4C 45 20 43  
00109Ar 2  52 41 53 48  
00109Fr 2               
00109Fr 2               ModeLabel:
00109Fr 2  4D 4F 44 45    .byte "MODE:",0
0010A3r 2  3A 00        
0010A5r 2               
0010A5r 2               ModeSuffix1P:
0010A5r 2  20 31 50 00    .byte " 1P",0
0010A9r 2               
0010A9r 2               ModeSuffix2P:
0010A9r 2  20 32 50 00    .byte " 2P",0
0010ADr 2               
0010ADr 2               P1ColorLabel:
0010ADr 2  50 31 3A 00    .byte "P1:",0
0010B1r 2               
0010B1r 2               P2ColorLabel:
0010B1r 2  50 32 3A 00    .byte "P2:",0
0010B5r 2               
0010B5r 2               ; One saturated, vivid shade per hue -- rendered every candidate shade to
0010B5r 2               ; the screen and looked at them side by side rather than going by name.
0010B5r 2               ; Result: for red and yellow specifically, the "light" tier is the pastel
0010B5r 2               ; one (salmon, pale khaki) and the "medium"/"dark" tier is the more vivid,
0010B5r 2               ; saturated look (true red, golden yellow) -- backwards from what the
0010B5r 2               ; names suggest. Blue's the exception: LT_BLUE reads as a rich periwinkle,
0010B5r 2               ; not pastel, so it stays over DK_BLUE. Green only offers MED_GREEN as the
0010B5r 2               ; vivid pick over the minty LT_GREEN. CYAN and MAGENTA only come in one
0010B5r 2               ; (already vivid) shade. GRAY rounds it out as a neutral -- WHITE was
0010B5r 2               ; considered too, but it's close enough to GRAY to not read as a distinct
0010B5r 2               ; option, and would've meant the lead pixel/head sprite (both hardcoded
0010B5r 2               ; white) blending into that one trail color instead of standing out.
0010B5r 2               TrailFgColorTable:
0010B5r 2  08 0A 02 07    .byte TMS_MED_RED, TMS_DK_YELLOW, TMS_MED_GREEN, TMS_CYAN, TMS_LT_BLUE, TMS_MAGENTA, TMS_GRAY
0010B9r 2  05 0D 0E     
0010BCr 2               
0010BCr 2               ApplyRequestedTurns:
0010BCr 2                 ; P1: reject exact 180 reversals.
0010BCr 2  A5 42          lda P1_DIR
0010BEr 2  C9 00          cmp #DIR_UP
0010C0r 2  D0 06          bne @p1NotUp
0010C2r 2  A5 43          lda P1_NEXT_DIR
0010C4r 2  C9 01          cmp #DIR_DOWN
0010C6r 2  F0 5B          beq @p1Done
0010C8r 2               @p1NotUp:
0010C8r 2  A5 42          lda P1_DIR
0010CAr 2  C9 01          cmp #DIR_DOWN
0010CCr 2  D0 06          bne @p1NotDown
0010CEr 2  A5 43          lda P1_NEXT_DIR
0010D0r 2  C9 00          cmp #DIR_UP
0010D2r 2  F0 4F          beq @p1Done
0010D4r 2               @p1NotDown:
0010D4r 2  A5 42          lda P1_DIR
0010D6r 2  C9 02          cmp #DIR_LEFT
0010D8r 2  D0 06          bne @p1NotLeft
0010DAr 2  A5 43          lda P1_NEXT_DIR
0010DCr 2  C9 03          cmp #DIR_RIGHT
0010DEr 2  F0 43          beq @p1Done
0010E0r 2               @p1NotLeft:
0010E0r 2  A5 42          lda P1_DIR
0010E2r 2  C9 03          cmp #DIR_RIGHT
0010E4r 2  D0 06          bne @p1Apply
0010E6r 2  A5 43          lda P1_NEXT_DIR
0010E8r 2  C9 02          cmp #DIR_LEFT
0010EAr 2  F0 37          beq @p1Done
0010ECr 2               @p1Apply:
0010ECr 2                 ; Turning onto a vertical heading (UP/DOWN) is only gated by X being
0010ECr 2                 ; byte-aligned (a multiple of 8, matching the TMS9918 color table's own
0010ECr 2                 ; 8-pixel granularity) when P2 actually has a claim somewhere in the
0010ECr 2                 ; column of color bytes this turn is about to travel through -- see
0010ECr 2                 ; the big comment on PixelSetP1Trail for why two different-colored
0010ECr 2                 ; trails sharing part of one 8-pixel-wide color byte can never both
0010ECr 2                 ; render correctly, full stop, on this hardware. That's only a real
0010ECr 2                 ; risk when the other trail is somewhere nearby; the overwhelming
0010ECr 2                 ; majority of turns happen nowhere near P2's trail at all, and gating
0010ECr 2                 ; every single one of those unconditionally meant instant turns almost
0010ECr 2                 ; never happened -- up to 7 ticks (560ms at this game's 80ms tick) of
0010ECr 2                 ; input lag on turns that were never actually in any danger of a color
0010ECr 2                 ; clash. PathClearOfOpponent scans P2_OWN_BUF down the whole column
0010ECr 2                 ; this run is about to travel, from my current row out to the wall --
0010ECr 2                 ; not just my current row, which used to miss a P2 trail sitting
0010ECr 2                 ; further down the same column and let the turn through anyway, only
0010ECr 2                 ; to bleed once the run reached it. Empty the whole way means turning
0010ECr 2                 ; right now is completely safe, so it takes effect immediately, same
0010ECr 2                 ; as it always did before any of this. Only when P2 already claims
0010ECr 2                 ; some row along that column does the alignment gate kick in, exactly
0010ECr 2                 ; as before. (The one case this still can't see is a P2 trail that
0010ECr 2                 ; hasn't reached that column yet AT ALL -- there's nothing in memory
0010ECr 2                 ; yet to scan for a move P2 hasn't made. That residual case falls back
0010ECr 2                 ; to the majority-vote/white-clash system in PixelSetP1Trail, same as
0010ECr 2                 ; any other near-miss.)
0010ECr 2  A5 43          lda P1_NEXT_DIR
0010EEr 2  C9 00          cmp #DIR_UP
0010F0r 2  F0 09          beq @p1CheckSafety
0010F2r 2  C9 01          cmp #DIR_DOWN
0010F4r 2  F0 05          beq @p1CheckSafety
0010F6r 2  85 42          sta P1_DIR
0010F8r 2  4C rr rr       jmp @p1Done
0010FBr 2               @p1CheckSafety:
0010FBr 2  A5 40          lda P1_X
0010FDr 2  85 77          sta SCAN_TMP2
0010FFr 2  A5 41          lda P1_Y
001101r 2  85 55          sta SCAN_TMP
001103r 2  A9 00          lda #<P2_OWN_BUF
001105r 2  85 72          sta FONT_PTR
001107r 2  A9 68          lda #>P2_OWN_BUF
001109r 2  85 73          sta FONT_PTR+1
00110Br 2  A5 43          lda P1_NEXT_DIR
00110Dr 2  20 rr rr       jsr PathClearOfOpponent
001110r 2  90 07          bcc @p1CheckAlign
001112r 2  A5 43          lda P1_NEXT_DIR
001114r 2  85 42          sta P1_DIR
001116r 2  4C rr rr       jmp @p1Done
001119r 2               @p1CheckAlign:
001119r 2  A5 40          lda P1_X
00111Br 2  29 07          and #7
00111Dr 2  D0 04          bne @p1Done
00111Fr 2  A5 43          lda P1_NEXT_DIR
001121r 2  85 42          sta P1_DIR
001123r 2               @p1Done:
001123r 2               
001123r 2                 ; P2: same reversal rule.
001123r 2  A5 47          lda P2_DIR
001125r 2  C9 00          cmp #DIR_UP
001127r 2  D0 06          bne @p2NotUp
001129r 2  A5 48          lda P2_NEXT_DIR
00112Br 2  C9 01          cmp #DIR_DOWN
00112Dr 2  F0 5B          beq @p2Done
00112Fr 2               @p2NotUp:
00112Fr 2  A5 47          lda P2_DIR
001131r 2  C9 01          cmp #DIR_DOWN
001133r 2  D0 06          bne @p2NotDown
001135r 2  A5 48          lda P2_NEXT_DIR
001137r 2  C9 00          cmp #DIR_UP
001139r 2  F0 4F          beq @p2Done
00113Br 2               @p2NotDown:
00113Br 2  A5 47          lda P2_DIR
00113Dr 2  C9 02          cmp #DIR_LEFT
00113Fr 2  D0 06          bne @p2NotLeft
001141r 2  A5 48          lda P2_NEXT_DIR
001143r 2  C9 03          cmp #DIR_RIGHT
001145r 2  F0 43          beq @p2Done
001147r 2               @p2NotLeft:
001147r 2  A5 47          lda P2_DIR
001149r 2  C9 03          cmp #DIR_RIGHT
00114Br 2  D0 06          bne @p2Apply
00114Dr 2  A5 48          lda P2_NEXT_DIR
00114Fr 2  C9 02          cmp #DIR_LEFT
001151r 2  F0 37          beq @p2Done
001153r 2               @p2Apply:
001153r 2                 ; Same opponent-proximity scan as P1 -- see the comment there. Checks
001153r 2                 ; P1_OWN_BUF instead, since P1 is the "other trail" from P2's side.
001153r 2  A5 48          lda P2_NEXT_DIR
001155r 2  C9 00          cmp #DIR_UP
001157r 2  F0 09          beq @p2CheckSafety
001159r 2  C9 01          cmp #DIR_DOWN
00115Br 2  F0 05          beq @p2CheckSafety
00115Dr 2  85 47          sta P2_DIR
00115Fr 2  4C rr rr       jmp @p2Done
001162r 2               @p2CheckSafety:
001162r 2  A5 45          lda P2_X
001164r 2  85 77          sta SCAN_TMP2
001166r 2  A5 46          lda P2_Y
001168r 2  85 55          sta SCAN_TMP
00116Ar 2  A9 00          lda #<P1_OWN_BUF
00116Cr 2  85 72          sta FONT_PTR
00116Er 2  A9 50          lda #>P1_OWN_BUF
001170r 2  85 73          sta FONT_PTR+1
001172r 2  A5 48          lda P2_NEXT_DIR
001174r 2  20 rr rr       jsr PathClearOfOpponent
001177r 2  90 07          bcc @p2CheckAlign
001179r 2  A5 48          lda P2_NEXT_DIR
00117Br 2  85 47          sta P2_DIR
00117Dr 2  4C rr rr       jmp @p2Done
001180r 2               @p2CheckAlign:
001180r 2  A5 45          lda P2_X
001182r 2  29 07          and #7
001184r 2  D0 04          bne @p2Done
001186r 2  A5 48          lda P2_NEXT_DIR
001188r 2  85 47          sta P2_DIR
00118Ar 2               @p2Done:
00118Ar 2  60             rts
00118Br 2               
00118Br 2               ; -----------------------------------------------------------------------------
00118Br 2               ; PathClearOfOpponent -- scans a vertical strip (fixed column, from the
00118Br 2               ; mover's current row out to the arena wall in the direction it's about
00118Br 2               ; to turn) for any row where the opponent already owns part of that
00118Br 2               ; row's shared color byte. See the comment in ApplyRequestedTurns for
00118Br 2               ; why this exists: the old check only looked at the mover's current row,
00118Br 2               ; blind to the same opponent trail sitting one row further down the
00118Br 2               ; column the turn is about to travel through for potentially many rows.
00118Br 2               ;
00118Br 2               ; In:  SCAN_TMP2 = column (X), SCAN_TMP = starting row (Y, mover's
00118Br 2               ;      current row), A = DIR_UP or DIR_DOWN (the heading being turned
00118Br 2               ;      onto)
00118Br 2               ;      FONT_PTR/FONT_PTR+1 = opponent's *_OWN_BUF base address, reused
00118Br 2               ;      here as a plain input pointer -- DrawChar, its only other user,
00118Br 2               ;      never runs during a gameplay tick (see TickPlaying), so there's
00118Br 2               ;      nothing to clobber
00118Br 2               ; Out: carry set = whole strip clear (turn is safe right now); carry
00118Br 2               ;      clear = opponent already owns part of some row in the strip
00118Br 2               ;      (caller falls back to the existing alignment gate)
00118Br 2               ; Clobbers: A, X, Y, SCAN_TMP, WORK_PTR, OFFSET_LO/HI, NUM_TMP,
00118Br 2               ;           AI_TEST_X/AI_TEST_Y (all via ComputePixelAddress)
00118Br 2               ; -----------------------------------------------------------------------------
00118Br 2               PathClearOfOpponent:
00118Br 2  C9 00          cmp #DIR_UP
00118Dr 2  F0 24          beq @upLoop
00118Fr 2               @downLoop:
00118Fr 2  A5 55          lda SCAN_TMP
001191r 2  A6 77          ldx SCAN_TMP2
001193r 2  20 rr rr       jsr ComputePixelAddress
001196r 2  A5 50          lda OFFSET_LO
001198r 2  18             clc
001199r 2  65 72          adc FONT_PTR
00119Br 2  85 52          sta WORK_PTR
00119Dr 2  A5 51          lda OFFSET_HI
00119Fr 2  65 73          adc FONT_PTR+1
0011A1r 2  85 53          sta WORK_PTR+1
0011A3r 2  A0 00          ldy #0
0011A5r 2  B1 52          lda (WORK_PTR),y
0011A7r 2  D0 2E          bne @hit
0011A9r 2  A5 55          lda SCAN_TMP
0011ABr 2  C9 BF          cmp #191
0011ADr 2  F0 26          beq @clear
0011AFr 2  E6 55          inc SCAN_TMP
0011B1r 2  80 DC          bra @downLoop
0011B3r 2               @upLoop:
0011B3r 2  A5 55          lda SCAN_TMP
0011B5r 2  A6 77          ldx SCAN_TMP2
0011B7r 2  20 rr rr       jsr ComputePixelAddress
0011BAr 2  A5 50          lda OFFSET_LO
0011BCr 2  18             clc
0011BDr 2  65 72          adc FONT_PTR
0011BFr 2  85 52          sta WORK_PTR
0011C1r 2  A5 51          lda OFFSET_HI
0011C3r 2  65 73          adc FONT_PTR+1
0011C5r 2  85 53          sta WORK_PTR+1
0011C7r 2  A0 00          ldy #0
0011C9r 2  B1 52          lda (WORK_PTR),y
0011CBr 2  D0 0A          bne @hit
0011CDr 2  A5 55          lda SCAN_TMP
0011CFr 2  F0 04          beq @clear
0011D1r 2  C6 55          dec SCAN_TMP
0011D3r 2  80 DE          bra @upLoop
0011D5r 2               @clear:
0011D5r 2  38             sec
0011D6r 2  60             rts
0011D7r 2               @hit:
0011D7r 2  18             clc
0011D8r 2  60             rts
0011D9r 2               
0011D9r 2               ; -----------------------------------------------------------------------------
0011D9r 2               ; ComputeP2LeftTurn / ComputeP2RightTurn -- the 90-degree turn-candidate
0011D9r 2               ; tables, factored out so ComputeP2AIDirection can try them in either
0011D9r 2               ; order (see the coin flip there). In: P2_DIR. Out: A = the candidate
0011D9r 2               ; direction for that turn from the current heading.
0011D9r 2               ;
0011D9r 2               ; Each case returns immediately after its lda instead of falling through
0011D9r 2               ; to a shared exit via bne. The old inline right-turn table used that
0011D9r 2               ; fall-through idiom and it broke for DIR_UP, which is 0: "lda #DIR_UP /
0011D9r 2               ; bne @rightReady" never branches when A is 0, so the LEFT-heading case
0011D9r 2               ; silently fell through into DIR_DOWN instead of DIR_UP -- P2 never even
0011D9r 2               ; tried its "up" escape when heading left. Returning per-case avoids that
0011D9r 2               ; class of bug rather than reproducing it here.
0011D9r 2               ; -----------------------------------------------------------------------------
0011D9r 2               ComputeP2LeftTurn:
0011D9r 2  A5 47          lda P2_DIR
0011DBr 2  C9 00          cmp #DIR_UP
0011DDr 2  D0 03          bne @lNotUp
0011DFr 2  A9 02          lda #DIR_LEFT
0011E1r 2  60             rts
0011E2r 2               @lNotUp:
0011E2r 2  A5 47          lda P2_DIR
0011E4r 2  C9 01          cmp #DIR_DOWN
0011E6r 2  D0 03          bne @lNotDown
0011E8r 2  A9 03          lda #DIR_RIGHT
0011EAr 2  60             rts
0011EBr 2               @lNotDown:
0011EBr 2  A5 47          lda P2_DIR
0011EDr 2  C9 02          cmp #DIR_LEFT
0011EFr 2  D0 03          bne @lNotLeft
0011F1r 2  A9 01          lda #DIR_DOWN
0011F3r 2  60             rts
0011F4r 2               @lNotLeft:
0011F4r 2  A9 00          lda #DIR_UP
0011F6r 2  60             rts
0011F7r 2               
0011F7r 2               ComputeP2RightTurn:
0011F7r 2  A5 47          lda P2_DIR
0011F9r 2  C9 00          cmp #DIR_UP
0011FBr 2  D0 03          bne @rNotUp
0011FDr 2  A9 03          lda #DIR_RIGHT
0011FFr 2  60             rts
001200r 2               @rNotUp:
001200r 2  A5 47          lda P2_DIR
001202r 2  C9 01          cmp #DIR_DOWN
001204r 2  D0 03          bne @rNotDown
001206r 2  A9 02          lda #DIR_LEFT
001208r 2  60             rts
001209r 2               @rNotDown:
001209r 2  A5 47          lda P2_DIR
00120Br 2  C9 02          cmp #DIR_LEFT
00120Dr 2  D0 03          bne @rNotLeft
00120Fr 2  A9 00          lda #DIR_UP
001211r 2  60             rts
001212r 2               @rNotLeft:
001212r 2  A9 01          lda #DIR_DOWN
001214r 2  60             rts
001215r 2               
001215r 2               ; -----------------------------------------------------------------------------
001215r 2               ; DirTowardP1 -- which of the two directions perpendicular to P2's
001215r 2               ; CURRENT heading closes the distance to P1 on the axis that matters.
001215r 2               ; P2_DIR horizontal -> compares Y (result is DIR_UP/DIR_DOWN). P2_DIR
001215r 2               ; vertical -> compares X (result is DIR_LEFT/DIR_RIGHT). Out: A = that
001215r 2               ; direction, or $FF if P1 is exactly level with P2 on that axis (no
001215r 2               ; preference either way).
001215r 2               ; -----------------------------------------------------------------------------
001215r 2               DirTowardP1:
001215r 2  A5 47          lda P2_DIR
001217r 2  C9 02          cmp #DIR_LEFT
001219r 2  F0 12          beq @axisIsY
00121Br 2  C9 03          cmp #DIR_RIGHT
00121Dr 2  F0 0E          beq @axisIsY
00121Fr 2               
00121Fr 2                 ; P2 currently vertical -- compare X.
00121Fr 2  A5 40          lda P1_X
001221r 2  C5 45          cmp P2_X
001223r 2  F0 16          beq @tied
001225r 2  90 03          bcc @wantLeft
001227r 2  A9 03          lda #DIR_RIGHT
001229r 2  60             rts
00122Ar 2               @wantLeft:
00122Ar 2  A9 02          lda #DIR_LEFT
00122Cr 2  60             rts
00122Dr 2               
00122Dr 2               @axisIsY:
00122Dr 2                 ; P2 currently horizontal -- compare Y.
00122Dr 2  A5 41          lda P1_Y
00122Fr 2  C5 46          cmp P2_Y
001231r 2  F0 08          beq @tied
001233r 2  90 03          bcc @wantUp
001235r 2  A9 01          lda #DIR_DOWN
001237r 2  60             rts
001238r 2               @wantUp:
001238r 2  A9 00          lda #DIR_UP
00123Ar 2  60             rts
00123Br 2               
00123Br 2               @tied:
00123Br 2  A9 FF          lda #$FF
00123Dr 2  60             rts
00123Er 2               
00123Er 2               ; -----------------------------------------------------------------------------
00123Er 2               ; ComputeP2AIDirection -- picks P2_NEXT_DIR from three candidates:
00123Er 2               ; continue straight, turn left, turn right.
00123Er 2               ;
00123Er 2               ; Continuing straight is preferred whenever it's safe -- but not
00123Er 2               ; absolutely: about 1 time in 16, even a safe straight run gets
00123Er 2               ; second-guessed and a turn is looked for anyway. Without this, P2 was a
00123Er 2               ; pure wall-follower that never changed course unless a wall forced it
00123Er 2               ; to, which is exactly what made it feel predictable and never actually
00123Er 2               ; came at P1 -- it only ever reacted to geometry, never to the other
00123Er 2               ; player.
00123Er 2               ;
00123Er 2               ; When a turn IS being considered (forced or not), left and right used
00123Er 2               ; to be a flat coin flip. Now DirTowardP1 picks whichever turn actually
00123Er 2               ; closes the distance to P1 on the relevant axis, and that's preferred
00123Er 2               ; about 3 times out of 4 -- not always, since an AI that beelines for
00123Er 2               ; the player with zero variance is its own kind of predictable, and the
00123Er 2               ; remaining 1-in-4 (or ties, where neither side is objectively better)
00123Er 2               ; falls back to the old plain coin flip.
00123Er 2               ; -----------------------------------------------------------------------------
00123Er 2               ComputeP2AIDirection:
00123Er 2  A5 47          lda P2_DIR
001240r 2  85 5A          sta AI_DIR_TMP
001242r 2  20 rr rr       jsr IsDirectionSafeP2
001245r 2  90 07          bcc @pickTurn
001247r 2               
001247r 2                 ; Continuing straight is safe -- usually just take it, but roll a
001247r 2                 ; small chance to look for a turn anyway.
001247r 2  20 rr rr       jsr AdvanceRng
00124Ar 2  29 0F          and #$0F
00124Cr 2  D0 52          bne @keepCurrent
00124Er 2               
00124Er 2               @pickTurn:
00124Er 2  20 rr rr       jsr DirTowardP1
001251r 2  85 81          sta AI_PREFERRED_DIR
001253r 2  C9 FF          cmp #$FF
001255r 2  F0 13          beq @coinFlip
001257r 2  20 rr rr       jsr AdvanceRng
00125Ar 2  29 03          and #3
00125Cr 2  C9 03          cmp #3
00125Er 2  F0 0A          beq @coinFlip
001260r 2  20 rr rr       jsr ComputeP2LeftTurn
001263r 2  C5 81          cmp AI_PREFERRED_DIR
001265r 2  F0 09          beq @tryLeftFirst
001267r 2  4C rr rr       jmp @tryRightFirst
00126Ar 2               
00126Ar 2               @coinFlip:
00126Ar 2  20 rr rr       jsr AdvanceRng
00126Dr 2  4A             lsr a
00126Er 2  B0 17          bcs @tryRightFirst
001270r 2               
001270r 2               @tryLeftFirst:
001270r 2  20 rr rr       jsr ComputeP2LeftTurn
001273r 2  85 5A          sta AI_DIR_TMP
001275r 2  20 rr rr       jsr IsDirectionSafeP2
001278r 2  B0 2B          bcs @useAiDir
00127Ar 2  20 rr rr       jsr ComputeP2RightTurn
00127Dr 2  85 5A          sta AI_DIR_TMP
00127Fr 2  20 rr rr       jsr IsDirectionSafeP2
001282r 2  B0 21          bcs @useAiDir
001284r 2  4C rr rr       jmp @noSafeTurn
001287r 2               
001287r 2               @tryRightFirst:
001287r 2  20 rr rr       jsr ComputeP2RightTurn
00128Ar 2  85 5A          sta AI_DIR_TMP
00128Cr 2  20 rr rr       jsr IsDirectionSafeP2
00128Fr 2  B0 14          bcs @useAiDir
001291r 2  20 rr rr       jsr ComputeP2LeftTurn
001294r 2  85 5A          sta AI_DIR_TMP
001296r 2  20 rr rr       jsr IsDirectionSafeP2
001299r 2  B0 0A          bcs @useAiDir
00129Br 2               
00129Br 2               @noSafeTurn:
00129Br 2                 ; No safe turn found: keep current.
00129Br 2  A5 47          lda P2_DIR
00129Dr 2  85 48          sta P2_NEXT_DIR
00129Fr 2  60             rts
0012A0r 2               
0012A0r 2               @keepCurrent:
0012A0r 2  A5 47          lda P2_DIR
0012A2r 2  85 48          sta P2_NEXT_DIR
0012A4r 2  60             rts
0012A5r 2               
0012A5r 2               @useAiDir:
0012A5r 2  A5 5A          lda AI_DIR_TMP
0012A7r 2  85 48          sta P2_NEXT_DIR
0012A9r 2  60             rts
0012AAr 2               
0012AAr 2               ; -----------------------------------------------------------------------------
0012AAr 2               ; IsDirectionSafeP2 — In: AI_DIR_TMP = candidate direction, using current
0012AAr 2               ; P2_X/P2_Y. Out: carry set if safe, clear if not.
0012AAr 2               ; A candidate turn from a horizontal heading onto UP/DOWN doesn't
0012AAr 2               ; necessarily take effect next tick the way a plain 1-step lookahead
0012AAr 2               ; assumes -- ApplyRequestedTurns holds a turn onto a vertical heading
0012AAr 2               ; until P2_X is grid-aligned (see the comment there), so P2 is committed
0012AAr 2               ; to continuing in its CURRENT direction for however many pixels remain
0012AAr 2               ; until that happens, not just the one step this used to check. Confirmed
0012AAr 2               ; via the debugger: the AI picked UP as "safe" one pixel from the border
0012AAr 2               ; while off-grid, the turn was held, and P2 drove straight into the wall
0012AAr 2               ; it had supposedly already decided to avoid. When the candidate is
0012AAr 2               ; vertical and the current heading is horizontal, walk every pixel of
0012AAr 2               ; that committed path first, then check the vertical step from wherever
0012AAr 2               ; it actually lands -- that's the real distance to safety, not 1 pixel.
0012AAr 2               ;
0012AAr 2               ; Continuing straight while ALREADY horizontal gets the same treatment,
0012AAr 2               ; for a different reason: ComputeP2AIDirection only looks for an escape
0012AAr 2               ; once continuing straight is unsafe, and a plain 1-step check doesn't
0012AAr 2               ; call that unsafe until the wall is the very next pixel -- by which
0012AAr 2               ; point P2 has typically already sailed past whatever grid line would
0012AAr 2               ; have let a turn through in time, and lands back off-grid with no room
0012AAr 2               ; left for the delay above. Confirmed the same way: P2 ran straight
0012AAr 2               ; through a fully aligned column with room to spare, reacted for the
0012AAr 2               ; first time one pixel from the border, and had nowhere left to turn.
0012AAr 2               ; Looking 8 pixels ahead here -- worst-case turn delay -- means the AI
0012AAr 2               ; calls "continue" unsafe early enough that a gated turn still has a
0012AAr 2               ; grid line to reach before whatever it saw coming actually arrives.
0012AAr 2               ;
0012AAr 2               ; Turning between two directions on an axis switch that ISN'T gated
0012AAr 2               ; (vertical-current -> horizontal-candidate, which always takes effect
0012AAr 2               ; immediately) keeps the plain single-step check -- there's no delay to
0012AAr 2               ; plan around there.
0012AAr 2               ;
0012AAr 2               ; Continuing straight while ALREADY vertical gets the same 8-pixel scan
0012AAr 2               ; as the horizontal case, for the same reason: a plain 1-step check
0012AAr 2               ; doesn't call the run unsafe until the wall is the very next pixel,
0012AAr 2               ; which reads as a last-instant twitch compared to the horizontal case's
0012AAr 2               ; visibly-early turn -- same underlying AI, inconsistent reaction
0012AAr 2               ; distance depending purely on which axis it happened to be moving on.
0012AAr 2               ; This isn't a gating-delay issue the way the horizontal case was (a
0012AAr 2               ; turn OFF of vertical onto horizontal is never gated, so the 1-step
0012AAr 2               ; check for the two turn candidates below is already exactly correct
0012AAr 2               ; and untouched) -- it's purely about giving the AI the same look-ahead
0012AAr 2               ; on both axes so its behavior doesn't visibly change shape depending on
0012AAr 2               ; which way it's facing.
0012AAr 2               ; -----------------------------------------------------------------------------
0012AAr 2               IsDirectionSafeP2:
0012AAr 2  A5 47          lda P2_DIR
0012ACr 2  C9 02          cmp #DIR_LEFT
0012AEr 2  F0 10          beq @currentHorizontal
0012B0r 2  C9 03          cmp #DIR_RIGHT
0012B2r 2  F0 0C          beq @currentHorizontal
0012B4r 2               
0012B4r 2                 ; Currently vertical (UP/DOWN). The two turn candidates (onto
0012B4r 2                 ; LEFT/RIGHT) fall through to @simple's plain 1-step check, same as
0012B4r 2                 ; always -- see the comment above for why that's still exactly right.
0012B4r 2                 ; Continuing straight (AI_DIR_TMP == P2_DIR) gets the extended scan.
0012B4r 2  A5 5A          lda AI_DIR_TMP
0012B6r 2  C5 47          cmp P2_DIR
0012B8r 2  D0 03          bne @notContinueV
0012BAr 2  4C rr rr       jmp @continueLookaheadV
0012BDr 2               @notContinueV:
0012BDr 2  4C rr rr       jmp @simple
0012C0r 2               
0012C0r 2               @currentHorizontal:
0012C0r 2  A5 5A          lda AI_DIR_TMP
0012C2r 2  C9 00          cmp #DIR_UP
0012C4r 2  F0 2F          beq @gated
0012C6r 2  C9 01          cmp #DIR_DOWN
0012C8r 2  F0 2B          beq @gated
0012CAr 2  80 00          bra @continueLookahead
0012CCr 2               
0012CCr 2               @continueLookahead:
0012CCr 2                 ; AI_DIR_TMP must equal P2_DIR here (horizontal continue) -- turning
0012CCr 2                 ; onto the opposite horizontal direction is a reversal and never a
0012CCr 2                 ; candidate ComputeP2AIDirection generates.
0012CCr 2  A5 45          lda P2_X
0012CEr 2  85 5B          sta AI_TEST_X
0012D0r 2  A5 46          lda P2_Y
0012D2r 2  85 5C          sta AI_TEST_Y
0012D4r 2  A9 08          lda #8
0012D6r 2  85 77          sta SCAN_TMP2
0012D8r 2               @clLoop:
0012D8r 2  A5 47          lda P2_DIR
0012DAr 2  C9 03          cmp #DIR_RIGHT
0012DCr 2  D0 04          bne @clDec
0012DEr 2  E6 5B          inc AI_TEST_X
0012E0r 2  80 02          bra @clCheck
0012E2r 2               @clDec:
0012E2r 2  C6 5B          dec AI_TEST_X
0012E4r 2               @clCheck:
0012E4r 2  A5 5C          lda AI_TEST_Y
0012E6r 2  A6 5B          ldx AI_TEST_X
0012E8r 2  20 rr rr       jsr PixelIsSet
0012EBr 2  D0 06          bne @clBlocked
0012EDr 2  C6 77          dec SCAN_TMP2
0012EFr 2  D0 E7          bne @clLoop
0012F1r 2  38             sec
0012F2r 2  60             rts
0012F3r 2               @clBlocked:
0012F3r 2  18             clc
0012F4r 2  60             rts
0012F5r 2               
0012F5r 2               @gated:
0012F5r 2                 ; Mirror ApplyRequestedTurns's own instant-vs-gated decision instead of
0012F5r 2                 ; always assuming the slow (walk-to-alignment) case. If P1's trail
0012F5r 2                 ; doesn't occupy the column P2 is about to turn into anywhere between
0012F5r 2                 ; here and the wall, ApplyRequestedTurns applies the turn INSTANTLY at
0012F5r 2                 ; P2's current, possibly-unaligned X -- not at some future aligned X.
0012F5r 2                 ; Checking safety at the walked-forward aligned position in that case
0012F5r 2                 ; verifies a cell P2 was never actually going to move into, while the
0012F5r 2                 ; cell it really moves into (one step vertically from right here)
0012F5r 2                 ; never gets checked at all. Confirmed via the debugger: a turn this
0012F5r 2                 ; check called safe landed P2 on an occupied pixel it had never
0012F5r 2                 ; examined, because the real move applied instantly at the current
0012F5r 2                 ; column while this check had verified a different, aligned column
0012F5r 2                 ; several pixels further along.
0012F5r 2  A5 45          lda P2_X
0012F7r 2  85 77          sta SCAN_TMP2
0012F9r 2  A5 46          lda P2_Y
0012FBr 2  85 55          sta SCAN_TMP
0012FDr 2  A9 00          lda #<P1_OWN_BUF
0012FFr 2  85 72          sta FONT_PTR
001301r 2  A9 50          lda #>P1_OWN_BUF
001303r 2  85 73          sta FONT_PTR+1
001305r 2  A5 5A          lda AI_DIR_TMP
001307r 2  20 rr rr       jsr PathClearOfOpponent
00130Ar 2  90 0A          bcc @gatedWalk
00130Cr 2                 ; Clear the whole way -- the turn applies instantly, right here.
00130Cr 2  A5 45          lda P2_X
00130Er 2  85 5B          sta AI_TEST_X
001310r 2  A5 46          lda P2_Y
001312r 2  85 5C          sta AI_TEST_Y
001314r 2  80 25          bra @gatedAligned
001316r 2               @gatedWalk:
001316r 2  A5 45          lda P2_X
001318r 2  85 5B          sta AI_TEST_X
00131Ar 2  A5 46          lda P2_Y
00131Cr 2  85 5C          sta AI_TEST_Y
00131Er 2               @gatedLoop:
00131Er 2  A5 5B          lda AI_TEST_X
001320r 2  29 07          and #7
001322r 2  F0 17          beq @gatedAligned
001324r 2  A5 47          lda P2_DIR
001326r 2  C9 03          cmp #DIR_RIGHT
001328r 2  D0 04          bne @gatedDec
00132Ar 2  E6 5B          inc AI_TEST_X
00132Cr 2  80 02          bra @gatedStepCheck
00132Er 2               @gatedDec:
00132Er 2  C6 5B          dec AI_TEST_X
001330r 2               @gatedStepCheck:
001330r 2  A5 5C          lda AI_TEST_Y
001332r 2  A6 5B          ldx AI_TEST_X
001334r 2  20 rr rr       jsr PixelIsSet
001337r 2  F0 E5          beq @gatedLoop
001339r 2  18             clc
00133Ar 2  60             rts
00133Br 2               @gatedAligned:
00133Br 2  A5 5A          lda AI_DIR_TMP
00133Dr 2  C9 00          cmp #DIR_UP
00133Fr 2  D0 04          bne @gatedDown
001341r 2  C6 5C          dec AI_TEST_Y
001343r 2  80 02          bra @gatedFinal
001345r 2               @gatedDown:
001345r 2  E6 5C          inc AI_TEST_Y
001347r 2               @gatedFinal:
001347r 2  A5 5C          lda AI_TEST_Y
001349r 2  C9 C0          cmp #192
00134Br 2  B0 09          bcs @gatedBlocked
00134Dr 2  A5 5C          lda AI_TEST_Y
00134Fr 2  A6 5B          ldx AI_TEST_X
001351r 2  20 rr rr       jsr PixelIsSet
001354r 2  F0 02          beq @gatedSafe
001356r 2               @gatedBlocked:
001356r 2  18             clc
001357r 2  60             rts
001358r 2               @gatedSafe:
001358r 2  38             sec
001359r 2  60             rts
00135Ar 2               
00135Ar 2               @continueLookaheadV:
00135Ar 2                 ; AI_DIR_TMP must equal P2_DIR here (vertical continue) -- see the
00135Ar 2                 ; header comment above. Same shape as @continueLookahead, just walking
00135Ar 2                 ; AI_TEST_Y instead of AI_TEST_X, with the same #192 bounds check
00135Ar 2                 ; @simple/@gated already use for a Y move (also catches the top edge:
00135Ar 2                 ; decrementing AI_TEST_Y past 0 wraps to 255, which is >= 192 too).
00135Ar 2  A5 45          lda P2_X
00135Cr 2  85 5B          sta AI_TEST_X
00135Er 2  A5 46          lda P2_Y
001360r 2  85 5C          sta AI_TEST_Y
001362r 2  A9 08          lda #8
001364r 2  85 77          sta SCAN_TMP2
001366r 2               @clvLoop:
001366r 2  A5 47          lda P2_DIR
001368r 2  C9 01          cmp #DIR_DOWN
00136Ar 2  D0 04          bne @clvDec
00136Cr 2  E6 5C          inc AI_TEST_Y
00136Er 2  80 02          bra @clvCheck
001370r 2               @clvDec:
001370r 2  C6 5C          dec AI_TEST_Y
001372r 2               @clvCheck:
001372r 2  A5 5C          lda AI_TEST_Y
001374r 2  C9 C0          cmp #192
001376r 2  B0 0F          bcs @clvBlocked
001378r 2  A5 5C          lda AI_TEST_Y
00137Ar 2  A6 5B          ldx AI_TEST_X
00137Cr 2  20 rr rr       jsr PixelIsSet
00137Fr 2  D0 06          bne @clvBlocked
001381r 2  C6 77          dec SCAN_TMP2
001383r 2  D0 E1          bne @clvLoop
001385r 2  38             sec
001386r 2  60             rts
001387r 2               @clvBlocked:
001387r 2  18             clc
001388r 2  60             rts
001389r 2               
001389r 2               @simple:
001389r 2  A5 45          lda P2_X
00138Br 2  85 5B          sta AI_TEST_X
00138Dr 2  A5 46          lda P2_Y
00138Fr 2  85 5C          sta AI_TEST_Y
001391r 2               
001391r 2  A5 5A          lda AI_DIR_TMP
001393r 2  C9 00          cmp #DIR_UP
001395r 2  D0 02          bne @sNotUp
001397r 2  C6 5C          dec AI_TEST_Y
001399r 2               @sNotUp:
001399r 2  A5 5A          lda AI_DIR_TMP
00139Br 2  C9 01          cmp #DIR_DOWN
00139Dr 2  D0 02          bne @sNotDown
00139Fr 2  E6 5C          inc AI_TEST_Y
0013A1r 2               @sNotDown:
0013A1r 2  A5 5A          lda AI_DIR_TMP
0013A3r 2  C9 02          cmp #DIR_LEFT
0013A5r 2  D0 02          bne @sNotLeft
0013A7r 2  C6 5B          dec AI_TEST_X
0013A9r 2               @sNotLeft:
0013A9r 2  A5 5A          lda AI_DIR_TMP
0013ABr 2  C9 03          cmp #DIR_RIGHT
0013ADr 2  D0 02          bne @sCheck
0013AFr 2  E6 5B          inc AI_TEST_X
0013B1r 2               
0013B1r 2               @sCheck:
0013B1r 2  A5 5C          lda AI_TEST_Y
0013B3r 2  C9 C0          cmp #192
0013B5r 2  B0 09          bcs @blocked
0013B7r 2  A5 5C          lda AI_TEST_Y
0013B9r 2  A6 5B          ldx AI_TEST_X
0013BBr 2  20 rr rr       jsr PixelIsSet
0013BEr 2  F0 02          beq @safe
0013C0r 2               @blocked:
0013C0r 2  18             clc
0013C1r 2  60             rts
0013C2r 2               @safe:
0013C2r 2  38             sec
0013C3r 2  60             rts
0013C4r 2               
0013C4r 2               ComputeNextPositions:
0013C4r 2  A5 40          lda P1_X
0013C6r 2  85 56          sta P1_NEXT_X
0013C8r 2  A5 41          lda P1_Y
0013CAr 2  85 57          sta P1_NEXT_Y
0013CCr 2               
0013CCr 2  A5 42          lda P1_DIR
0013CEr 2  C9 00          cmp #DIR_UP
0013D0r 2  D0 02          bne @p1NotUp
0013D2r 2  C6 57          dec P1_NEXT_Y
0013D4r 2               @p1NotUp:
0013D4r 2  A5 42          lda P1_DIR
0013D6r 2  C9 01          cmp #DIR_DOWN
0013D8r 2  D0 02          bne @p1NotDown
0013DAr 2  E6 57          inc P1_NEXT_Y
0013DCr 2               @p1NotDown:
0013DCr 2  A5 42          lda P1_DIR
0013DEr 2  C9 02          cmp #DIR_LEFT
0013E0r 2  D0 02          bne @p1NotLeft
0013E2r 2  C6 56          dec P1_NEXT_X
0013E4r 2               @p1NotLeft:
0013E4r 2  A5 42          lda P1_DIR
0013E6r 2  C9 03          cmp #DIR_RIGHT
0013E8r 2  D0 02          bne @p1Done
0013EAr 2  E6 56          inc P1_NEXT_X
0013ECr 2               @p1Done:
0013ECr 2               
0013ECr 2  A5 45          lda P2_X
0013EEr 2  85 58          sta P2_NEXT_X
0013F0r 2  A5 46          lda P2_Y
0013F2r 2  85 59          sta P2_NEXT_Y
0013F4r 2               
0013F4r 2  A5 47          lda P2_DIR
0013F6r 2  C9 00          cmp #DIR_UP
0013F8r 2  D0 02          bne @p2NotUp
0013FAr 2  C6 59          dec P2_NEXT_Y
0013FCr 2               @p2NotUp:
0013FCr 2  A5 47          lda P2_DIR
0013FEr 2  C9 01          cmp #DIR_DOWN
001400r 2  D0 02          bne @p2NotDown
001402r 2  E6 59          inc P2_NEXT_Y
001404r 2               @p2NotDown:
001404r 2  A5 47          lda P2_DIR
001406r 2  C9 02          cmp #DIR_LEFT
001408r 2  D0 02          bne @p2NotLeft
00140Ar 2  C6 58          dec P2_NEXT_X
00140Cr 2               @p2NotLeft:
00140Cr 2  A5 47          lda P2_DIR
00140Er 2  C9 03          cmp #DIR_RIGHT
001410r 2  D0 02          bne @p2Done
001412r 2  E6 58          inc P2_NEXT_X
001414r 2               @p2Done:
001414r 2  60             rts
001415r 2               
001415r 2               CommitP1Move:
001415r 2  A5 56          lda P1_NEXT_X
001417r 2  85 40          sta P1_X
001419r 2  A5 57          lda P1_NEXT_Y
00141Br 2  85 41          sta P1_Y
00141Dr 2               
00141Dr 2  A5 41          lda P1_Y
00141Fr 2  A6 40          ldx P1_X
001421r 2  20 rr rr       jsr PixelSetP1Trail
001424r 2  60             rts
001425r 2               
001425r 2               CommitP2Move:
001425r 2  A5 58          lda P2_NEXT_X
001427r 2  85 45          sta P2_X
001429r 2  A5 59          lda P2_NEXT_Y
00142Br 2  85 46          sta P2_Y
00142Dr 2               
00142Dr 2  A5 46          lda P2_Y
00142Fr 2  A6 45          ldx P2_X
001431r 2  20 rr rr       jsr PixelSetP2Trail
001434r 2  60             rts
001435r 2               
001435r 1               
001435r 1               .segment "CART"
001435r 1               
001435r 1               GAME_SPEED_LO = 8
001435r 1               GAME_SPEED_HI = 0
001435r 1               
001435r 1               CartReset:
001435r 1  A2 FF          ldx #$ff
001437r 1  9A             txs                             ; KernalInit does not reset the stack
001438r 1  20 78 A0       jsr KernalInit                  ; pointer or enable interrupts itself --
00143Br 1  58             cli                              ; every sibling cartridge in this family
00143Cr 1                                                   ; does both here, and skipping them left
00143Cr 1                                                   ; the IRQ-driven keyboard scanner (and
00143Cr 1                                                   ; anything else interrupt-driven) dead
00143Cr 1               
00143Cr 1  A9 00          lda #0
00143Er 1  20 0F A0       jsr SetIOMode                   ; video/local keyboard, so Chrin (used by
001441r 1                                                   ; the joystick-first keyboard fallback,
001441r 1                                                   ; including on the title screen, before
001441r 1                                                   ; StartRound's own SetIOMode call would
001441r 1                                                   ; otherwise be the first one) reads from
001441r 1                                                   ; the right source from the very start
001441r 1               
001441r 1  20 15 A0       jsr InitVideo
001444r 1  20 rr rr       jsr InitGraphicsI
001447r 1  20 rr rr       jsr NewGame
00144Ar 1               
00144Ar 1               MainLoop:
00144Ar 1  20 rr rr       jsr PollInput
00144Dr 1  20 rr rr       jsr PollInputP2
001450r 1  20 rr rr       jsr Tick
001453r 1  A9 08          lda #GAME_SPEED_LO
001455r 1  A2 00          ldx #GAME_SPEED_HI
001457r 1  20 75 A0       jsr SysDelay
00145Ar 1  4C rr rr       jmp MainLoop
00145Dr 1               
00145Dr 1               ; Dispatch through the RAM vectors KernalInit points at the Kernal's own
00145Dr 1               ; default handlers (keyboard scanning included) -- a bare `rti` here, as
00145Dr 1               ; this cartridge had before, means the IRQ-driven keyboard scanner (and
00145Dr 1               ; anything else interrupt-driven) never runs at all, regardless of cli.
00145Dr 1               IrqTrampoline:
00145Dr 1  6C 00 03       jmp (IRQ_PTR)
001460r 1               
001460r 1               NmiTrampoline:
001460r 1  6C 04 03       jmp (NMI_PTR)
001463r 1               
001463r 1               .segment "VECTORS"
000000r 1  rr rr        .word NmiTrampoline
000002r 1  rr rr        .word CartReset
000004r 1  rr rr        .word IrqTrampoline
000004r 1               
