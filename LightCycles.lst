00024Er 2  C9 B7          cmp #ARENA_MAX_Y
000250r 2  D0 EA          bne @sides
000252r 2  60             rts
000253r 2               
000253r 2               ; -----------------------------------------------------------------------------
000253r 2               ; PixelSetP1Trail / PixelSetP2Trail — draw one trail pixel, then resolve
000253r 2               ; that pixel's 8-wide VDP color byte by majority vote instead of generic
000253r 2               ; PixelSet's first-claim-wins rule. TMS9918 Graphics II has one
000253r 2               ; foreground color per 8 horizontal pixels per scanline -- when both
000253r 2               ; trails pass within 8 pixels of each other on the same row, only one
000253r 2               ; color can ever be shown for that whole byte; that's a hardware fact, no
000253r 2               ; way around it. But first-claim-wins meant whichever trail happened to
000253r 2               ; touch the byte FIRST kept it forever, even after the other trail went
000253r 2               ; on to own most of the byte's actual pixels -- a single early pixel
000253r 2               ; could permanently mis-color a byte the other player ends up
000253r 2               ; dominating. Recomputing the color from a real per-pixel ownership
000253r 2               ; record (P1_OWN_BUF/P2_OWN_BUF, tracked separately from the VDP color
000253r 2               ; table) every time either trail touches the byte means it always
000253r 2               ; reflects whichever player currently owns more of its 8 pixels, not
000253r 2               ; just whoever arrived first.
000253r 2               ; An exact tie (equal ownership) renders as a flat TMS_WHITE "clash"
000253r 2               ; instead of picking one player's color -- there IS no correct choice
000253r 2               ; between two truly-equal owners, and forcing one still reads as a bug
000253r 2               ; (first tried "whichever trail is drawing now," which silently always
000253r 2               ; meant P2 since CommitP1Move always runs before CommitP2Move; then row
000253r 2               ; parity, which alternates the two colors every row and just trades one
000253r 2               ; glitchy-looking pattern for another). White reuses the same "shared
000253r 2               ; boundary" language the lead pixel and head sprites already use, so two
000253r 2               ; trails running side by side long enough to genuinely tie a byte reads
000253r 2               ; as a deliberate spark/clash effect, not a rendering error.
000253r 2               ; In: A = row, X = col
000253r 2               ; Out: none
000253r 2               ; Clobbers: A, X, Y, WORK_PTR, OFFSET_LO/HI, NUM_TMP, SCAN_TMP, SCAN_TMP2
000253r 2               ; -----------------------------------------------------------------------------
000253r 2               PixelSetP1Trail:
000253r 2  20 rr rr       jsr ComputePixelAddress
000256r 2               
000256r 2  A0 00          ldy #0
000258r 2  B1 52          lda (WORK_PTR),y
00025Ar 2  05 5F          ora NUM_TMP
00025Cr 2  91 52          sta (WORK_PTR),y
00025Er 2               
00025Er 2  08             php
00025Fr 2  78             sei
000260r 2  48             pha
000261r 2  A5 50          lda OFFSET_LO
000263r 2  A6 51          ldx OFFSET_HI
000265r 2  20 rr rr       jsr VdpSetAddr
000268r 2  68             pla
000269r 2  8D 00 9C       sta VC_DATA
00026Cr 2  28             plp
00026Dr 2               
00026Dr 2  A5 50          lda OFFSET_LO                ; claim this pixel in P1's ownership plane
00026Fr 2  18             clc
000270r 2  69 00          adc #<P1_OWN_BUF
000272r 2  85 52          sta WORK_PTR
000274r 2  A5 51          lda OFFSET_HI
000276r 2  69 50          adc #>P1_OWN_BUF
000278r 2  85 53          sta WORK_PTR+1
00027Ar 2  A0 00          ldy #0
00027Cr 2  B1 52          lda (WORK_PTR),y
00027Er 2  05 5F          ora NUM_TMP
000280r 2  91 52          sta (WORK_PTR),y
000282r 2  AA             tax
000283r 2  BD rr rr       lda PopcountTable,x
000286r 2  85 55          sta SCAN_TMP                  ; P1's bit count in this byte
000288r 2               
000288r 2  A5 50          lda OFFSET_LO                ; read (not claim) P2's count in this byte
00028Ar 2  18             clc
00028Br 2  69 00          adc #<P2_OWN_BUF
00028Dr 2  85 52          sta WORK_PTR
00028Fr 2  A5 51          lda OFFSET_HI
000291r 2  69 68          adc #>P2_OWN_BUF
000293r 2  85 53          sta WORK_PTR+1
000295r 2  A0 00          ldy #0
000297r 2  B1 52          lda (WORK_PTR),y
000299r 2  AA             tax
00029Ar 2  BD rr rr       lda PopcountTable,x
00029Dr 2  85 77          sta SCAN_TMP2
00029Fr 2               
00029Fr 2  A5 77          lda SCAN_TMP2
0002A1r 2  C5 55          cmp SCAN_TMP
0002A3r 2  90 06          bcc @p1Wins                   ; P2count < P1count
0002A5r 2  F0 08          beq @tie
0002A7r 2  A5 65          lda P2_TRAIL_COLOR             ; P2count > P1count
0002A9r 2  80 06          bra @haveColor
0002ABr 2               @p1Wins:
0002ABr 2  A5 64          lda P1_TRAIL_COLOR
0002ADr 2  80 02          bra @haveColor
0002AFr 2               @tie:
0002AFr 2  A9 0F          lda #TMS_WHITE
0002B1r 2               @haveColor:
0002B1r 2  4C rr rr       jmp TrailColorCommit
0002B4r 2               
0002B4r 2               PixelSetP2Trail:
0002B4r 2  20 rr rr       jsr ComputePixelAddress
0002B7r 2               
0002B7r 2  A0 00          ldy #0
0002B9r 2  B1 52          lda (WORK_PTR),y
0002BBr 2  05 5F          ora NUM_TMP
0002BDr 2  91 52          sta (WORK_PTR),y
0002BFr 2               
0002BFr 2  08             php
0002C0r 2  78             sei
0002C1r 2  48             pha
0002C2r 2  A5 50          lda OFFSET_LO
0002C4r 2  A6 51          ldx OFFSET_HI
0002C6r 2  20 rr rr       jsr VdpSetAddr
0002C9r 2  68             pla
0002CAr 2  8D 00 9C       sta VC_DATA
0002CDr 2  28             plp
0002CEr 2               
0002CEr 2  A5 50          lda OFFSET_LO                ; claim this pixel in P2's ownership plane
0002D0r 2  18             clc
0002D1r 2  69 00          adc #<P2_OWN_BUF
0002D3r 2  85 52          sta WORK_PTR
0002D5r 2  A5 51          lda OFFSET_HI
0002D7r 2  69 68          adc #>P2_OWN_BUF
0002D9r 2  85 53          sta WORK_PTR+1
0002DBr 2  A0 00          ldy #0
0002DDr 2  B1 52          lda (WORK_PTR),y
0002DFr 2  05 5F          ora NUM_TMP
0002E1r 2  91 52          sta (WORK_PTR),y
0002E3r 2  AA             tax
0002E4r 2  BD rr rr       lda PopcountTable,x
0002E7r 2  85 77          sta SCAN_TMP2                 ; P2's bit count in this byte
0002E9r 2               
0002E9r 2  A5 50          lda OFFSET_LO                ; read (not claim) P1's count in this byte
0002EBr 2  18             clc
0002ECr 2  69 00          adc #<P1_OWN_BUF
0002EEr 2  85 52          sta WORK_PTR
0002F0r 2  A5 51          lda OFFSET_HI
0002F2r 2  69 50          adc #>P1_OWN_BUF
0002F4r 2  85 53          sta WORK_PTR+1
0002F6r 2  A0 00          ldy #0
0002F8r 2  B1 52          lda (WORK_PTR),y
0002FAr 2  AA             tax
0002FBr 2  BD rr rr       lda PopcountTable,x
0002FEr 2  85 55          sta SCAN_TMP
000300r 2               
000300r 2  A5 55          lda SCAN_TMP
000302r 2  C5 77          cmp SCAN_TMP2
000304r 2  90 06          bcc @p2Wins                   ; P1count < P2count
000306r 2  F0 08          beq @tie
000308r 2  A5 64          lda P1_TRAIL_COLOR             ; P1count > P2count
00030Ar 2  80 06          bra @haveColor
00030Cr 2               @p2Wins:
00030Cr 2  A5 65          lda P2_TRAIL_COLOR
00030Er 2  80 02          bra @haveColor
000310r 2               @tie:
000310r 2  A9 0F          lda #TMS_WHITE
000312r 2               @haveColor:
000312r 2                 ; fall through to TrailColorCommit
000312r 2               
000312r 2               ; Shared tail for PixelSetP1Trail/PixelSetP2Trail: A = the winning
000312r 2               ; player's trail color (TMS_* value); OFFSET_LO/HI still hold this
000312r 2               ; pixel's byte offset from the ComputePixelAddress call above. Writes
000312r 2               ; that color to the byte's VDP color-table entry unconditionally (unlike
000312r 2               ; PixelSet's color path, which only writes when the byte was empty).
000312r 2               TrailColorCommit:
000312r 2  0A             asl a
000313r 2  0A             asl a
000314r 2  0A             asl a
000315r 2  0A             asl a
000316r 2  09 01          ora #TMS_BLACK
000318r 2  85 5F          sta NUM_TMP
00031Ar 2               
00031Ar 2  A5 50          lda OFFSET_LO
00031Cr 2  18             clc
00031Dr 2  69 00          adc #<COLOR_BUF
00031Fr 2  85 52          sta WORK_PTR
000321r 2  A5 51          lda OFFSET_HI
000323r 2  69 38          adc #>COLOR_BUF
000325r 2  85 53          sta WORK_PTR+1
000327r 2  A0 00          ldy #0
000329r 2  A5 5F          lda NUM_TMP
00032Br 2  91 52          sta (WORK_PTR),y
00032Dr 2               
00032Dr 2  A5 51          lda OFFSET_HI
00032Fr 2  18             clc
000330r 2  69 20          adc #>COLOR_TABLE_BASE
000332r 2  AA             tax
000333r 2  A5 50          lda OFFSET_LO
000335r 2  08             php
000336r 2  78             sei
000337r 2  20 rr rr       jsr VdpSetAddr
00033Ar 2  A5 5F          lda NUM_TMP
00033Cr 2  8D 00 9C       sta VC_DATA
00033Fr 2  28             plp
000340r 2  60             rts
000341r 2               
000341r 2               ; PopcountTable[n] = number of set bits in n -- used to compare how much
000341r 2               ; of a shared 8-pixel color byte each player currently owns.
000341r 2               PopcountTable:
000341r 2  00 01 01 02    .byte 0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4
000345r 2  01 02 02 03  
000349r 2  01 02 02 03  
000351r 2  01 02 02 03    .byte 1, 2, 2, 3, 2, 3, 3, 4, 2, 3, 3, 4, 3, 4, 4, 5
000355r 2  02 03 03 04  
000359r 2  02 03 03 04  
000361r 2  01 02 02 03    .byte 1, 2, 2, 3, 2, 3, 3, 4, 2, 3, 3, 4, 3, 4, 4, 5
000365r 2  02 03 03 04  
000369r 2  02 03 03 04  
000371r 2  02 03 03 04    .byte 2, 3, 3, 4, 3, 4, 4, 5, 3, 4, 4, 5, 4, 5, 5, 6
000375r 2  03 04 04 05  
000379r 2  03 04 04 05  
000381r 2  01 02 02 03    .byte 1, 2, 2, 3, 2, 3, 3, 4, 2, 3, 3, 4, 3, 4, 4, 5
000385r 2  02 03 03 04  
000389r 2  02 03 03 04  
000391r 2  02 03 03 04    .byte 2, 3, 3, 4, 3, 4, 4, 5, 3, 4, 4, 5, 4, 5, 5, 6
000395r 2  03 04 04 05  
000399r 2  03 04 04 05  
0003A1r 2  02 03 03 04    .byte 2, 3, 3, 4, 3, 4, 4, 5, 3, 4, 4, 5, 4, 5, 5, 6
0003A5r 2  03 04 04 05  
0003A9r 2  03 04 04 05  
0003B1r 2  03 04 04 05    .byte 3, 4, 4, 5, 4, 5, 5, 6, 4, 5, 5, 6, 5, 6, 6, 7
0003B5r 2  04 05 05 06  
0003B9r 2  04 05 05 06  
0003C1r 2  01 02 02 03    .byte 1, 2, 2, 3, 2, 3, 3, 4, 2, 3, 3, 4, 3, 4, 4, 5
0003C5r 2  02 03 03 04  
0003C9r 2  02 03 03 04  
0003D1r 2  02 03 03 04    .byte 2, 3, 3, 4, 3, 4, 4, 5, 3, 4, 4, 5, 4, 5, 5, 6
0003D5r 2  03 04 04 05  
0003D9r 2  03 04 04 05  
0003E1r 2  02 03 03 04    .byte 2, 3, 3, 4, 3, 4, 4, 5, 3, 4, 4, 5, 4, 5, 5, 6
0003E5r 2  03 04 04 05  
0003E9r 2  03 04 04 05  
0003F1r 2  03 04 04 05    .byte 3, 4, 4, 5, 4, 5, 5, 6, 4, 5, 5, 6, 5, 6, 6, 7
0003F5r 2  04 05 05 06  
0003F9r 2  04 05 05 06  
000401r 2  02 03 03 04    .byte 2, 3, 3, 4, 3, 4, 4, 5, 3, 4, 4, 5, 4, 5, 5, 6
000405r 2  03 04 04 05  
000409r 2  03 04 04 05  
000411r 2  03 04 04 05    .byte 3, 4, 4, 5, 4, 5, 5, 6, 4, 5, 5, 6, 5, 6, 6, 7
000415r 2  04 05 05 06  
000419r 2  04 05 05 06  
000421r 2  03 04 04 05    .byte 3, 4, 4, 5, 4, 5, 5, 6, 4, 5, 5, 6, 5, 6, 6, 7
000425r 2  04 05 05 06  
000429r 2  04 05 05 06  
000431r 2  04 05 05 06    .byte 4, 5, 5, 6, 5, 6, 6, 7, 5, 6, 6, 7, 6, 7, 7, 8
000435r 2  05 06 06 07  
000439r 2  05 06 06 07  
000441r 2               
000441r 2               PixelSetBorder:
000441r 2  A0 05          ldy #BORDER_FG
000443r 2  4C rr rr       jmp PixelSet
000446r 2               
000446r 2               PixelSet:
000446r 2  84 60          sty DIGIT_TMP
000448r 2  DA             phx
000449r 2  5A             phy
00044Ar 2  20 rr rr       jsr ComputePixelAddress
00044Dr 2  A0 00          ldy #0
00044Fr 2  B1 52          lda (WORK_PTR),y
000451r 2  05 5F          ora NUM_TMP
000453r 2  91 52          sta (WORK_PTR),y
000455r 2               
000455r 2  08             php
000456r 2  78             sei
000457r 2  48             pha
000458r 2  A5 50          lda OFFSET_LO
00045Ar 2  A6 51          ldx OFFSET_HI
00045Cr 2  20 rr rr       jsr VdpSetAddr
00045Fr 2  68             pla
000460r 2  8D 00 9C       sta VC_DATA
000463r 2  28             plp
000464r 2               
000464r 2  A5 60          lda DIGIT_TMP
000466r 2  0A             asl a
000467r 2  0A             asl a
000468r 2  0A             asl a
000469r 2  0A             asl a
00046Ar 2  09 01          ora #TMS_BLACK
00046Cr 2  85 5F          sta NUM_TMP
00046Er 2               
00046Er 2                 ; Map the same byte offset into COLOR_BUF and only set a color once.
00046Er 2  A5 50          lda OFFSET_LO
000470r 2  18             clc
000471r 2  69 00          adc #<COLOR_BUF
000473r 2  85 52          sta WORK_PTR
000475r 2  A5 51          lda OFFSET_HI
000477r 2  69 38          adc #>COLOR_BUF
000479r 2  85 53          sta WORK_PTR+1
00047Br 2               
00047Br 2  A0 00          ldy #0
00047Dr 2  B1 52          lda (WORK_PTR),y
00047Fr 2  C9 11          cmp #COLOR_EMPTY
000481r 2  D0 17          bne @doneColor
000483r 2               
000483r 2  A5 5F          lda NUM_TMP
000485r 2  91 52          sta (WORK_PTR),y
000487r 2               
000487r 2  A5 51          lda OFFSET_HI
000489r 2  18             clc
00048Ar 2  69 20          adc #>COLOR_TABLE_BASE
00048Cr 2  AA             tax
00048Dr 2  A5 50          lda OFFSET_LO
00048Fr 2  08             php
000490r 2  78             sei
000491r 2  20 rr rr       jsr VdpSetAddr
000494r 2  A5 5F          lda NUM_TMP
000496r 2  8D 00 9C       sta VC_DATA
000499r 2  28             plp
00049Ar 2               @doneColor:
00049Ar 2  7A             ply
00049Br 2  FA             plx
00049Cr 2  60             rts
00049Dr 2               
00049Dr 2               ; -----------------------------------------------------------------------------
00049Dr 2               ; PixelClear — the inverse of PixelSet: unset one pixel's bit and reset its
00049Dr 2               ; color-cell back to COLOR_EMPTY unconditionally (erasing always releases
00049Dr 2               ; ownership, unlike PixelSet's first-writer-wins claim). Needed because
00049Dr 2               ; PixelSet only ever ORs bits on -- redrawing changed text (the title
00049Dr 2               ; screen's MODE: 1P/2P line, or a color swatch after the player cycles
00049Dr 2               ; color) without erasing first just overlays the new glyph's pixels on the
00049Dr 2               ; old one instead of replacing it, so nothing looks like it's updating.
00049Dr 2               ; In: A = row, X = col
00049Dr 2               ; Out: none
00049Dr 2               ; Clobbers: A, X, Y, plus everything ComputePixelAddress/VdpSetAddr clobber
00049Dr 2               ; -----------------------------------------------------------------------------
00049Dr 2               PixelClear:
00049Dr 2  DA             phx
00049Er 2  5A             phy
00049Fr 2  20 rr rr       jsr ComputePixelAddress
0004A2r 2               
0004A2r 2  A5 5F          lda NUM_TMP
0004A4r 2  49 FF          eor #$FF
0004A6r 2  85 74          sta FONT_TMP              ; inverted mask; FONT_TMP is safe scratch here,
0004A8r 2                                             ; not concurrently used by anything on this
0004A8r 2                                             ; call path
0004A8r 2  A0 00          ldy #0
0004AAr 2  B1 52          lda (WORK_PTR),y
0004ACr 2  25 74          and FONT_TMP
0004AEr 2  91 52          sta (WORK_PTR),y
0004B0r 2               
0004B0r 2  08             php
0004B1r 2  78             sei
0004B2r 2  48             pha
0004B3r 2  A5 50          lda OFFSET_LO
0004B5r 2  A6 51          ldx OFFSET_HI
0004B7r 2  20 rr rr       jsr VdpSetAddr
0004BAr 2  68             pla
0004BBr 2  8D 00 9C       sta VC_DATA
0004BEr 2  28             plp
0004BFr 2               
0004BFr 2  A5 50          lda OFFSET_LO
0004C1r 2  18             clc
0004C2r 2  69 00          adc #<COLOR_BUF
0004C4r 2  85 52          sta WORK_PTR
0004C6r 2  A5 51          lda OFFSET_HI
0004C8r 2  69 38          adc #>COLOR_BUF
0004CAr 2  85 53          sta WORK_PTR+1
0004CCr 2  A9 11          lda #COLOR_EMPTY
0004CEr 2  A0 00          ldy #0
0004D0r 2  91 52          sta (WORK_PTR),y
0004D2r 2               
0004D2r 2  A5 51          lda OFFSET_HI
0004D4r 2  18             clc
0004D5r 2  69 20          adc #>COLOR_TABLE_BASE
0004D7r 2  AA             tax
0004D8r 2  A5 50          lda OFFSET_LO
0004DAr 2  08             php
0004DBr 2  78             sei
0004DCr 2  20 rr rr       jsr VdpSetAddr
0004DFr 2  A9 11          lda #COLOR_EMPTY
0004E1r 2  8D 00 9C       sta VC_DATA
0004E4r 2  28             plp
0004E5r 2               
0004E5r 2  7A             ply
0004E6r 2  FA             plx
0004E7r 2  60             rts
0004E8r 2               
0004E8r 2               ; -----------------------------------------------------------------------------
0004E8r 2               ; EraseRect — clear every pixel in a rectangular region, via PixelClear.
0004E8r 2               ; In: A = top row, X = left col, TEXT_ROW_I/TEXT_COL_I hold the height and
0004E8r 2               ;     width on entry (caller sets them as byte values before calling,
0004E8r 2               ;     reusing DrawChar's scratch since the two never run concurrently)
0004E8r 2               ; Out: none
0004E8r 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, plus everything PixelClear clobbers
0004E8r 2               ; -----------------------------------------------------------------------------
0004E8r 2               EraseRect:
0004E8r 2  85 55          sta SCAN_TMP               ; origin row
0004EAr 2  86 77          stx SCAN_TMP2               ; origin col
0004ECr 2  A5 75          lda TEXT_ROW_I
0004EEr 2  85 7A          sta FONT_HI                  ; stash height (PixelClear doesn't touch this)
0004F0r 2  A5 76          lda TEXT_COL_I
0004F2r 2  85 71          sta TEXT_COLOR                ; stash width -- deliberately NOT FONT_TMP,
0004F4r 2                                                 ; since PixelClear (called every iteration
0004F4r 2                                                 ; below) uses FONT_TMP as its own internal
0004F4r 2                                                 ; scratch and would clobber it
0004F4r 2               
0004F4r 2  64 75          stz TEXT_ROW_I
0004F6r 2               @rowLoop:
0004F6r 2  64 76          stz TEXT_COL_I
0004F8r 2               @colLoop:
0004F8r 2  A5 76          lda TEXT_COL_I
0004FAr 2  18             clc
0004FBr 2  65 77          adc SCAN_TMP2
0004FDr 2  AA             tax
0004FEr 2  A5 75          lda TEXT_ROW_I
000500r 2  18             clc
000501r 2  65 55          adc SCAN_TMP
000503r 2  20 rr rr       jsr PixelClear
000506r 2               
000506r 2  E6 76          inc TEXT_COL_I
000508r 2  A5 76          lda TEXT_COL_I
00050Ar 2  C5 71          cmp TEXT_COLOR
00050Cr 2  D0 EA          bne @colLoop
00050Er 2               
00050Er 2  E6 75          inc TEXT_ROW_I
000510r 2  A5 75          lda TEXT_ROW_I
000512r 2  C5 7A          cmp FONT_HI
000514r 2  D0 E0          bne @rowLoop
000516r 2  60             rts
000517r 2               
000517r 2               PixelIsSet:
000517r 2  DA             phx
000518r 2  5A             phy
000519r 2  20 rr rr       jsr ComputePixelAddress
00051Cr 2  A0 00          ldy #0
00051Er 2  B1 52          lda (WORK_PTR),y
000520r 2  25 5F          and NUM_TMP
000522r 2  F0 05          beq @clear
000524r 2  7A             ply
000525r 2  FA             plx
000526r 2  A9 01          lda #1
000528r 2  60             rts
000529r 2               @clear:
000529r 2  7A             ply
00052Ar 2  FA             plx
00052Br 2  A9 00          lda #0
00052Dr 2  60             rts
00052Er 2               
00052Er 2               ComputePixelAddress:
00052Er 2                 ; In: A = y (0..191), X = x (0..255)
00052Er 2                 ; Out: WORK_PTR points to shadow-byte, OFFSET_LO/HI = VRAM byte address,
00052Er 2                 ;      NUM_TMP = mask bit for the pixel.
00052Er 2  85 5C          sta AI_TEST_Y
000530r 2  86 5B          stx AI_TEST_X
000532r 2               
000532r 2                 ; Graphics II pattern-byte address:
000532r 2                 ; third*0x800 + charRow*0x100 + xByte*8 + yWithinChar
000532r 2                 ; where third = y/64, charRow = (y&63)/8.
000532r 2  A5 5C          lda AI_TEST_Y
000534r 2  29 07          and #$07
000536r 2  85 50          sta OFFSET_LO               ; yWithinChar
000538r 2  64 51          stz OFFSET_HI
00053Ar 2               
00053Ar 2  A5 5B          lda AI_TEST_X
00053Cr 2  4A             lsr a
00053Dr 2  4A             lsr a
00053Er 2  4A             lsr a
00053Fr 2  0A             asl a
000540r 2  0A             asl a
000541r 2  0A             asl a
000542r 2  18             clc
000543r 2  65 50          adc OFFSET_LO               ; + xByte*8
000545r 2  85 50          sta OFFSET_LO
000547r 2  90 02          bcc :+
000549r 2  E6 51          inc OFFSET_HI
00054Br 2               :
00054Br 2               
00054Br 2  A5 5C          lda AI_TEST_Y
00054Dr 2  29 38          and #$38                    ; char-row source bits
00054Fr 2  4A             lsr a
000550r 2  4A             lsr a
000551r 2  4A             lsr a                        ; charRow (0..7)
000552r 2  18             clc
000553r 2  65 51          adc OFFSET_HI               ; + charRow*256 into high byte
000555r 2  85 51          sta OFFSET_HI
000557r 2               
000557r 2  A5 5C          lda AI_TEST_Y
000559r 2  29 C0          and #$C0                    ; third of screen
00055Br 2  4A             lsr a
00055Cr 2  4A             lsr a
00055Dr 2  4A             lsr a
00055Er 2  18             clc
00055Fr 2  65 51          adc OFFSET_HI               ; + third*0x800 into high byte
000561r 2  85 51          sta OFFSET_HI
000563r 2               
000563r 2  A5 50          lda OFFSET_LO
000565r 2  18             clc
000566r 2  69 00          adc #<BITMAP_BUF
000568r 2  85 52          sta WORK_PTR
00056Ar 2  A5 51          lda OFFSET_HI
00056Cr 2  69 20          adc #>BITMAP_BUF
00056Er 2  85 53          sta WORK_PTR+1
000570r 2               
000570r 2  A5 5B          lda AI_TEST_X
000572r 2  29 07          and #$07
000574r 2  A8             tay
000575r 2  B9 rr rr       lda PixelMaskTable,y
000578r 2  85 5F          sta NUM_TMP
00057Ar 2  60             rts
00057Br 2               
00057Br 2               PixelMaskTable:
00057Br 2  80 40 20 10    .byte $80, $40, $20, $10, $08, $04, $02, $01
00057Fr 2  08 04 02 01  
000583r 2               
000583r 2               ; -----------------------------------------------------------------------------
000583r 2               ; DrawChar — plot one character's 5x7 pixel glyph into the bitmap plane.
000583r 2               ; In:  A = ASCII character code (space through 'Z'; anything outside that
000583r 2               ;      range draws nothing, since no game text uses it)
000583r 2               ;      TEXT_ROW/TEXT_COL = top-left pixel origin, TEXT_COLOR = TMS_* color
000583r 2               ; Out: none. TEXT_ROW/TEXT_COL are left unchanged (DrawText advances
000583r 2               ;      TEXT_COL between characters; a lone DrawChar caller can too).
000583r 2               ; Clobbers: A, X, Y, FONT_PTR, FONT_TMP, FONT_HI, TEXT_ROW_I, TEXT_COL_I
000583r 2               ; -----------------------------------------------------------------------------
000583r 2               DrawChar:
000583r 2  C9 20          cmp #' '
000585r 2  90 54          bcc @done
000587r 2  C9 5B          cmp #('Z'+1)
000589r 2  B0 50          bcs @done
00058Br 2               
00058Br 2  38             sec
00058Cr 2  E9 20          sbc #' '                 ; A = (char - ' '), index into FontData
00058Er 2  85 74          sta FONT_TMP
000590r 2  0A             asl a
000591r 2  0A             asl a
000592r 2  18             clc
000593r 2  65 74          adc FONT_TMP              ; A = (index*5) mod 256; carry = the bit this
000595r 2                                            ; 8-bit add lost -- index*5 reaches 290 for
000595r 2                                            ; 'Z', past what one byte holds, and that
000595r 2                                            ; overflow bit has to reach FONT_PTR's high
000595r 2                                            ; byte, not just get thrown away by a clc
000595r 2  64 7A          stz FONT_HI
000597r 2  90 02          bcc @noHi
000599r 2  E6 7A          inc FONT_HI
00059Br 2               @noHi:
00059Br 2               
00059Br 2  18             clc
00059Cr 2  69 rr          adc #<FontData
00059Er 2  85 72          sta FONT_PTR
0005A0r 2  A5 7A          lda FONT_HI
0005A2r 2  69 rr          adc #>FontData
0005A4r 2  85 73          sta FONT_PTR+1
0005A6r 2               
0005A6r 2  64 76          stz TEXT_COL_I
0005A8r 2               @colLoop:
0005A8r 2  A4 76          ldy TEXT_COL_I
0005AAr 2  B1 72          lda (FONT_PTR),y
0005ACr 2  85 74          sta FONT_TMP
0005AEr 2               
0005AEr 2  64 75          stz TEXT_ROW_I
0005B0r 2               @rowLoop:
0005B0r 2  A6 75          ldx TEXT_ROW_I
0005B2r 2  A5 74          lda FONT_TMP
0005B4r 2  3D rr rr       and FontBitMask,x
0005B7r 2  F0 12          beq @rowSkip
0005B9r 2               
0005B9r 2  A5 75          lda TEXT_ROW_I
0005BBr 2  18             clc
0005BCr 2  65 6F          adc TEXT_ROW
0005BEr 2  48             pha
0005BFr 2  A5 76          lda TEXT_COL_I
0005C1r 2  18             clc
0005C2r 2  65 70          adc TEXT_COL
0005C4r 2  AA             tax
0005C5r 2  68             pla
0005C6r 2  A4 71          ldy TEXT_COLOR
0005C8r 2  20 rr rr       jsr PixelSet
0005CBr 2               
0005CBr 2               @rowSkip:
0005CBr 2  E6 75          inc TEXT_ROW_I
0005CDr 2  A5 75          lda TEXT_ROW_I
0005CFr 2  C9 07          cmp #7
0005D1r 2  D0 DD          bne @rowLoop
0005D3r 2               
0005D3r 2  E6 76          inc TEXT_COL_I
0005D5r 2  A5 76          lda TEXT_COL_I
0005D7r 2  C9 05          cmp #5
0005D9r 2  D0 CD          bne @colLoop
0005DBr 2               
0005DBr 2               @done:
0005DBr 2  60             rts
0005DCr 2               
0005DCr 2               FontBitMask:
0005DCr 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40
0005E0r 2  10 20 40     
0005E3r 2               
0005E3r 2               ; -----------------------------------------------------------------------------
0005E3r 2               ; DrawText — plot a null-terminated string, one glyph every 6 pixels (5 wide
0005E3r 2               ; plus 1 blank column of spacing).
0005E3r 2               ; In:  TEXT_STR_PTR = string pointer, TEXT_ROW/TEXT_COL = origin, TEXT_COLOR
0005E3r 2               ;      Deliberately NOT WORK_PTR -- DrawChar calls down into PixelSet /
0005E3r 2               ;      ComputePixelAddress, which clobbers WORK_PTR for its own shadow-
0005E3r 2               ;      buffer addressing on every pixel, so the string pointer needs its
0005E3r 2               ;      own zero-page home that survives those nested calls.
0005E3r 2               ; Out: TEXT_COL is left just past the string's last character
0005E3r 2               ; Clobbers: A, X, Y, STR_IDX, plus everything DrawChar clobbers
0005E3r 2               ; -----------------------------------------------------------------------------
0005E3r 2               DrawText:
0005E3r 2  64 54          stz STR_IDX
0005E5r 2               @loop:
0005E5r 2  A4 54          ldy STR_IDX
0005E7r 2  B1 78          lda (TEXT_STR_PTR),y
0005E9r 2  F0 0F          beq @done
0005EBr 2  20 rr rr       jsr DrawChar
0005EEr 2  A5 70          lda TEXT_COL
0005F0r 2  18             clc
0005F1r 2  69 06          adc #6
0005F3r 2  85 70          sta TEXT_COL
0005F5r 2  E6 54          inc STR_IDX
0005F7r 2  4C rr rr       jmp @loop
0005FAr 2               @done:
0005FAr 2  60             rts
0005FBr 2               
0005FBr 2               ; -----------------------------------------------------------------------------
0005FBr 2               ; DrawCharBig — like DrawChar, but each font pixel becomes a 2x2 block
0005FBr 2               ; (10x14 pixels per glyph instead of 5x7), for a title that reads as an
0005FBr 2               ; actual title instead of just another line of body text. Reuses FontData
0005FBr 2               ; as-is rather than needing a second, separately-authored big font.
0005FBr 2               ; In:  A = ASCII character code (space through 'Z')
0005FBr 2               ;      TEXT_ROW/TEXT_COL = top-left pixel origin, TEXT_COLOR = TMS_* color
0005FBr 2               ; Out: none
0005FBr 2               ; Clobbers: A, X, Y, FONT_PTR, FONT_TMP, FONT_HI, TEXT_ROW_I, TEXT_COL_I,
0005FBr 2               ;   SCAN_TMP, SCAN_TMP2
0005FBr 2               ; -----------------------------------------------------------------------------
0005FBr 2               DrawCharBig:
0005FBr 2  C9 20          cmp #' '
0005FDr 2  90 7E          bcc @done
0005FFr 2  C9 5B          cmp #('Z'+1)
000601r 2  B0 7A          bcs @done
000603r 2               
000603r 2  38             sec
000604r 2  E9 20          sbc #' '
000606r 2  85 74          sta FONT_TMP
000608r 2  0A             asl a
000609r 2  0A             asl a
00060Ar 2  18             clc
00060Br 2  65 74          adc FONT_TMP
00060Dr 2  64 7A          stz FONT_HI
00060Fr 2  90 02          bcc @noHi
000611r 2  E6 7A          inc FONT_HI
000613r 2               @noHi:
000613r 2               
000613r 2  18             clc
000614r 2  69 rr          adc #<FontData
000616r 2  85 72          sta FONT_PTR
000618r 2  A5 7A          lda FONT_HI
00061Ar 2  69 rr          adc #>FontData
00061Cr 2  85 73          sta FONT_PTR+1
00061Er 2               
00061Er 2  64 76          stz TEXT_COL_I
000620r 2               @colLoop:
000620r 2  A4 76          ldy TEXT_COL_I
000622r 2  B1 72          lda (FONT_PTR),y
000624r 2  85 74          sta FONT_TMP
000626r 2               
000626r 2  64 75          stz TEXT_ROW_I
000628r 2               @rowLoop:
000628r 2  A6 75          ldx TEXT_ROW_I
00062Ar 2  A5 74          lda FONT_TMP
00062Cr 2  3D rr rr       and FontBitMask,x
00062Fr 2  F0 3C          beq @rowSkip
000631r 2               
000631r 2  A5 75          lda TEXT_ROW_I               ; SCAN_TMP = scaled absolute row (top of
000633r 2  0A             asl a                          ; this font pixel's 2x2 block)
000634r 2  18             clc
000635r 2  65 6F          adc TEXT_ROW
000637r 2  85 55          sta SCAN_TMP
000639r 2  A5 76          lda TEXT_COL_I               ; SCAN_TMP2 = scaled absolute col (left
00063Br 2  0A             asl a                          ; of this font pixel's 2x2 block)
00063Cr 2  18             clc
00063Dr 2  65 70          adc TEXT_COL
00063Fr 2  85 77          sta SCAN_TMP2
000641r 2               
000641r 2  A5 55          lda SCAN_TMP
000643r 2  A6 77          ldx SCAN_TMP2
000645r 2  A4 71          ldy TEXT_COLOR
000647r 2  20 rr rr       jsr PixelSet
00064Ar 2               
00064Ar 2  A5 55          lda SCAN_TMP
00064Cr 2  A6 77          ldx SCAN_TMP2
00064Er 2  E8             inx
00064Fr 2  A4 71          ldy TEXT_COLOR
000651r 2  20 rr rr       jsr PixelSet
000654r 2               
000654r 2  A5 55          lda SCAN_TMP
000656r 2  18             clc
000657r 2  69 01          adc #1
000659r 2  A6 77          ldx SCAN_TMP2
00065Br 2  A4 71          ldy TEXT_COLOR
00065Dr 2  20 rr rr       jsr PixelSet
000660r 2               
000660r 2  A5 55          lda SCAN_TMP
000662r 2  18             clc
000663r 2  69 01          adc #1
000665r 2  A6 77          ldx SCAN_TMP2
000667r 2  E8             inx
000668r 2  A4 71          ldy TEXT_COLOR
00066Ar 2  20 rr rr       jsr PixelSet
00066Dr 2               
00066Dr 2               @rowSkip:
00066Dr 2  E6 75          inc TEXT_ROW_I
00066Fr 2  A5 75          lda TEXT_ROW_I
000671r 2  C9 07          cmp #7
000673r 2  D0 B3          bne @rowLoop
000675r 2               
000675r 2  E6 76          inc TEXT_COL_I
000677r 2  A5 76          lda TEXT_COL_I
000679r 2  C9 05          cmp #5
00067Br 2  D0 A3          bne @colLoop
00067Dr 2               
00067Dr 2               @done:
00067Dr 2  60             rts
00067Er 2               
00067Er 2               ; -----------------------------------------------------------------------------
00067Er 2               ; DrawTextBig — DrawText's counterpart for DrawCharBig: one glyph every 12
00067Er 2               ; pixels (10 wide plus 2 blank columns of spacing) instead of 6.
00067Er 2               ; In:  TEXT_STR_PTR = string pointer, TEXT_ROW/TEXT_COL = origin, TEXT_COLOR
00067Er 2               ; Out: TEXT_COL is left just past the string's last character
00067Er 2               ; -----------------------------------------------------------------------------
00067Er 2               DrawTextBig:
00067Er 2  64 54          stz STR_IDX
000680r 2               @loop:
000680r 2  A4 54          ldy STR_IDX
000682r 2  B1 78          lda (TEXT_STR_PTR),y
000684r 2  F0 0F          beq @done
000686r 2  20 rr rr       jsr DrawCharBig
000689r 2  A5 70          lda TEXT_COL
00068Br 2  18             clc
00068Cr 2  69 0C          adc #12
00068Er 2  85 70          sta TEXT_COL
000690r 2  E6 54          inc STR_IDX
000692r 2  4C rr rr       jmp @loop
000695r 2               @done:
000695r 2  60             rts
000696r 2               
000696r 2               ; -----------------------------------------------------------------------------
000696r 2               ; DrawColorSwatch — fill a small 7x7 pixel block with a solid color, used to
000696r 2               ; preview a player's selected trail color on the title screen. 7px to match
000696r 2               ; the font's own glyph height, so the swatch reads as sitting on the same
000696r 2               ; line as the "P1:"/"P2:" text instead of an arbitrary size. Reuses
000696r 2               ; DrawChar's TEXT_ROW_I/TEXT_COL_I as generic loop counters, safe since the
000696r 2               ; two routines are never active at the same time.
000696r 2               ; In: A = top-left row, X = top-left col, Y = TMS_* color
000696r 2               ; Out: none
000696r 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, TEXT_ROW_I, TEXT_COL_I, TEXT_COLOR,
000696r 2               ;   plus everything PixelSet clobbers
000696r 2               ; -----------------------------------------------------------------------------
000696r 2               DrawColorSwatch:
000696r 2  85 55          sta SCAN_TMP               ; origin row
000698r 2  86 77          stx SCAN_TMP2               ; origin col
00069Ar 2  84 71          sty TEXT_COLOR
00069Cr 2               
00069Cr 2  64 75          stz TEXT_ROW_I
00069Er 2               @rowLoop:
00069Er 2  64 76          stz TEXT_COL_I
0006A0r 2               @colLoop:
0006A0r 2  A5 76          lda TEXT_COL_I
0006A2r 2  18             clc
0006A3r 2  65 77          adc SCAN_TMP2
0006A5r 2  AA             tax                          ; X = this pixel's absolute column
0006A6r 2  A5 75          lda TEXT_ROW_I
0006A8r 2  18             clc
0006A9r 2  65 55          adc SCAN_TMP                 ; A = this pixel's absolute row
0006ABr 2  A4 71          ldy TEXT_COLOR
0006ADr 2  20 rr rr       jsr PixelSet
0006B0r 2               
0006B0r 2  E6 76          inc TEXT_COL_I
0006B2r 2  A5 76          lda TEXT_COL_I
0006B4r 2  C9 07          cmp #7
0006B6r 2  D0 E8          bne @colLoop
0006B8r 2               
0006B8r 2  E6 75          inc TEXT_ROW_I
0006BAr 2  A5 75          lda TEXT_ROW_I
0006BCr 2  C9 07          cmp #7
0006BEr 2  D0 DE          bne @rowLoop
0006C0r 2  60             rts
0006C1r 2               
0006C1r 2               ; -----------------------------------------------------------------------------
0006C1r 2               ; DrawUpTriangle / DrawDownTriangle — a small 5x3 "you can go this way"
0006C1r 2               ; affordance. The color swatches already have an accurate hint in their
0006C1r 2               ; left/right chevrons, since they really are a left/right control; MODE
0006C1r 2               ; is a up/down control, so it gets a matching up/down shape instead of
0006C1r 2               ; reusing the chevrons sideways, which wouldn't actually say "up/down" to
0006C1r 2               ; anyone looking at it.
