0001E4r 2  85 52          sta WORK_PTR
0001E6r 2  A9 68          lda #>P2_OWN_BUF
0001E8r 2  85 53          sta WORK_PTR+1
0001EAr 2  A2 18          ldx #$18
0001ECr 2  A9 00          lda #0
0001EEr 2               @clrP2OwnPage:
